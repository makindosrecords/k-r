---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  hideFooter?: boolean;
}

const {
  title = "K&R Photography | Weddings, Portraits & Real Estate | Central Florida",
  description = "Central Florida's premier husband-and-wife photography studio. 20+ years experience. 380+ 5-star Google reviews. Weddings, family portraits & real estate across Central Florida.",
  image = "/weddings/KIM_8014-2_result.webp",
  type = "website",
  hideFooter = false
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://kandrpix.com');
const socialImageURL = new URL(image, Astro.site || 'https://kandrpix.com');

const schemaData = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "K&R Photography",
  "legalName": "K&R Photography LLC",
  "founders": [
    { "@type": "Person", "name": "Kimberly" },
    { "@type": "Person", "name": "Rick" }
  ],
  "image": "https://kandrpix.com/weddings/KIM_8014-2_result.webp",
  "url": "https://kandrpix.com",
  "telephone": "+14074900898",
  "email": "kimberly@kandrpix.com",
  "priceRange": "$$$",
  "address": {
    "@type": "PostalAddress",
    "addressRegion": "FL",
    "addressCountry": "US"
  },
  "areaServed": [
    { "@type": "City", "name": "Orlando" },
    { "@type": "City", "name": "Winter Park" },
    { "@type": "City", "name": "Cocoa Beach" },
    { "@type": "City", "name": "Daytona Beach" },
    { "@type": "City", "name": "Windermere" },
    { "@type": "City", "name": "Kissimmee" },
    { "@type": "State", "name": "Central Florida" }
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "bestRating": "5.0",
    "ratingCount": "380",
    "reviewCount": "380"
  },
  "sameAs": [
    "https://instagram.com/kandrpix",
    "https://www.google.com/search?q=K%26R+Photography+Orlando"
  ]
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="canonical" href={canonicalURL} />

  <!-- Primary Meta Tags -->
  <title>{title}</title>
  <meta name="title" content={title} />
  <meta name="description" content={description} />
  <meta name="author" content="Kimberly & Rick" />

  <!-- Open Graph / Facebook / iMessage -->
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="K&R Photography" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={socialImageURL} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="K&R Photography Editorial Portfolio" />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonicalURL} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={socialImageURL} />

  <!-- Favicon & Mobile Touch Icons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/favicon.svg" />
  <meta name="theme-color" content="#11100F" />
  <meta name="color-scheme" content="light dark" />

  <!-- Google Fonts Preconnect & Optimized Font Loading -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700;800&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,300;1,400;1,600&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700;800&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,300;1,400;1,600&display=swap" media="print" onload="this.media='all'" />
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700;800&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,300;1,400;1,600&display=swap" />
  </noscript>

  <!-- LCP Hero Image Preload (Responsive) -->
  <link rel="preload" as="image" href="/KIM_5271-2_result_720w.webp" media="(max-width: 768px)" fetchpriority="high" />
  <link rel="preload" as="image" href="/KIM_5271-2_result.webp" media="(min-width: 769px)" fetchpriority="high" />

  <!-- JSON-LD LocalBusiness Rich Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  <slot name="head" />
</head>
<body>

  <!-- Site Header -->
  <header class="site-header" id="site-header">
    <!-- Logo -->
    <a href="/" class="header-logo">
      <span class="logo-title">K&R</span>
      <span class="logo-sub">PHOTOGRAPHY</span>
    </a>

    <!-- Desktop Nav -->
    <nav class="desktop-nav hide-mobile">
      <div class="nav-dropdown-wrap">
        <span class="nav-link nav-link-dropdown-trigger">
          Weddings &amp; Portraits
          <svg class="nav-caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
        </span>
        <div class="nav-dropdown">
          <a href="/weddings-and-couples" class="nav-dropdown-link">
            <div class="nav-dropdown-title">Weddings &amp; Couples</div>
          </a>
          <a href="/family-and-portraits" class="nav-dropdown-link">
            <div class="nav-dropdown-title">Family &amp; Portraits</div>
          </a>
