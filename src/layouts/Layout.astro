    <a href="/contact" class="mfb-btn mfb-inquire" aria-label="Check Availability and Inquire">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:#B89635;flex-shrink:0;">
