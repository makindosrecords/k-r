<script>
  function initPageScripts() {
    // ─── HEADER SCROLL & FLOATING BAR ───
    const header = document.getElementById('site-header');
    const floatingBar = document.getElementById('mobile-floating-bar');
    window.addEventListener('scroll', () => {
      const scrollY = window.scrollY;
      if (header) {
        header.classList.toggle('scrolled', scrollY > 60);
      }
    }, { passive: true });

    // ─── MOBILE MENU ───
    const toggle = document.getElementById('mobile-toggle');
    const drawer = document.getElementById('mobile-drawer');
    const iconMenu = document.getElementById('icon-menu');
    const iconClose = document.getElementById('icon-close');
    let drawerOpen = false;

    toggle?.addEventListener('click', () => {
      drawerOpen = !drawerOpen;
      if (drawer) drawer.style.display = drawerOpen ? 'flex' : 'none';
      if (iconMenu) iconMenu.style.display = drawerOpen ? 'none' : 'block';
      if (iconClose) iconClose.style.display = drawerOpen ? 'block' : 'none';
      if (floatingBar) floatingBar.classList.toggle('hidden', drawerOpen);
      document.body.style.overflow = drawerOpen ? 'hidden' : '';
    });

    drawer?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        drawerOpen = false;
        if (drawer) drawer.style.display = 'none';
        if (iconMenu) iconMenu.style.display = 'block';
        if (iconClose) iconClose.style.display = 'none';
        if (floatingBar) floatingBar.classList.remove('hidden');
        document.body.style.overflow = '';
      });
    });

    // ─── SCROLL REVEAL ───
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -60px 0px' });

    document.querySelectorAll('.reveal, .reveal-left, .reveal-right, .stagger-children, .img-wipe, .word-reveal').forEach(el => {
      observer.observe(el);
    });

    // ─── HERO ZOOM TRANSITION & PARALLAX ───
    const heroBg = document.querySelector('.hero-bg') as HTMLElement | null;
    const ctaBgImg = document.querySelector('.cta-bg-img') as HTMLElement | null;

    if (heroBg) {
      // Trigger loaded zoom transition
      requestAnimationFrame(() => {
        setTimeout(() => {
          heroBg.classList.add('loaded');
        }, 50);
      });
    }

    window.addEventListener('scroll', () => {
      const y = window.scrollY;
      const heroHeight = window.innerHeight;
      if (heroBg) {
        if (y <= heroHeight) {
          heroBg.style.transform = `scale(1) translateY(${y * 0.25}px)`;
        }
      }
      if (ctaBgImg) ctaBgImg.style.transform = `scale(1.05) translateY(${-y * 0.05}px)`;
    }, { passive: true });
  }

  // ─── GLOBAL EVENT DELEGATION FOR POSTHOG (INSTANT CAPTURE) ───
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    if (typeof (window as any).posthog === 'undefined') return;

    // 1. Direct Phone & Email clicks
    const telLink = target?.closest('a[href^="tel:"]') as HTMLAnchorElement | null;
    const mailtoLink = target?.closest('a[href^="mailto:"]') as HTMLAnchorElement | null;

    if (telLink) {
      const phone = telLink.getAttribute('href')?.replace('tel:', '') || '(407) 497-9239';
      (window as any).posthog.capture('phone_call_clicked', {
        phone_number: phone,
        page_location: window.location.pathname,
        link_text: telLink.innerText?.trim() || 'Call Button'
      });
    }

    if (mailtoLink) {
      const email = mailtoLink.getAttribute('href')?.replace('mailto:', '') || 'kimberly@kandrpix.com';
      (window as any).posthog.capture('email_link_clicked', {
        email_address: email,
        page_location: window.location.pathname,
        link_text: mailtoLink.innerText?.trim() || 'Email Link'
      });
    }

    // 2. Lightbox Photo Clicks (Portfolio & Home Gallery)
    const artCard = target?.closest('.art-plate-card, .gallery-card, [data-category], [data-image]') as HTMLElement | null;
    if (artCard) {
      const title = artCard.getAttribute('data-title') || artCard.querySelector('img')?.getAttribute('alt') || 'Featured Photo';
      const category = artCard.getAttribute('data-cat') || artCard.getAttribute('data-category') || 'Portfolio';
      const location = artCard.getAttribute('data-loc') || '';
      const src = artCard.getAttribute('data-image') || artCard.querySelector('img')?.getAttribute('src') || '';

      console.log('[PostHog] Capturing photo_viewed_in_lightbox:', title, category);
      (window as any).posthog.capture('photo_viewed_in_lightbox', {
        photo_title: title,
        category: category,
        location: location,
        image_src: src,
        page_location: window.location.pathname
      });
    }

    // 3. Film / Video Modal Clicks (Weddings & Real Estate)
    const videoCard = target?.closest('.film-preview-card, [data-video-id]') as HTMLElement | null;
    if (videoCard) {
      const videoTitle = videoCard.getAttribute('data-video-title') || 'Featured Film';
      const videoId = videoCard.getAttribute('data-video-id') || '';
      const category = window.location.pathname.includes('wedding') ? 'Weddings & Couples' : 'Real Estate';

      console.log('[PostHog] Capturing video_modal_played:', videoTitle);
      (window as any).posthog.capture('video_modal_played', {
        video_title: videoTitle,
        video_id: videoId,
        category: category,
        page_location: window.location.pathname
      });
    }
  }, { capture: true });

  // Run on initial page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPageScripts);
  } else {
    initPageScripts();
  }
  document.addEventListener('astro:page-load', initPageScripts);
</script>
