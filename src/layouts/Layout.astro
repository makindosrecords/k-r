    </button>
  </header>

  <!-- Mobile Nav Drawer -->
  <div id="mobile-drawer" style="position:fixed;inset:0;background:rgba(12,10,8,0.97);backdrop-filter:blur(24px);z-index:1000;display:none;flex-direction:column;justify-content:space-between;align-items:center;padding:110px 28px 48px;overflow-y:auto;">
    <div style="font-family:'Cinzel',serif;font-size:11px;letter-spacing:0.3em;color:#A3802C;text-transform:uppercase;font-weight:600;">KIMBERLY & RICK · EST. 2004</div>
    
    <div style="display:flex;flex-direction:column;align-items:center;gap:24px;width:100%;text-align:center;margin:auto 0;">
      <a href="/weddings-and-couples" style="font-family:'Cormorant Garamond',serif;font-size:clamp(28px,7vw,36px);font-weight:400;color:#FAF8F5;text-decoration:none;transition:color 0.2s;">Weddings & Couples</a>
      <a href="/family-and-portraits" style="font-family:'Cormorant Garamond',serif;font-size:clamp(28px,7vw,36px);font-weight:400;color:#FAF8F5;text-decoration:none;transition:color 0.2s;">Family & Portraits</a>
      <a href="/real-estate" style="font-family:'Cormorant Garamond',serif;font-size:clamp(28px,7vw,36px);font-weight:400;color:#FAF8F5;text-decoration:none;transition:color 0.2s;">Real Estate Media</a>
      <a href="/packages" style="font-family:'Cormorant Garamond',serif;font-size:clamp(28px,7vw,36px);font-weight:400;color:#FAF8F5;text-decoration:none;transition:color 0.2s;">Packages & Pricing</a>
      <a href="/portfolio" style="font-family:'Cormorant Garamond',serif;font-size:clamp(28px,7vw,36px);font-weight:400;color:#FAF8F5;text-decoration:none;transition:color 0.2s;">Portfolio Archive</a>
      <a href="/contact" style="margin-top:12px;width:100%;max-width:280px;text-align:center;" class="cta-btn">Inquire & Reserve Date</a>
    </div>

    <div style="display:flex;flex-direction:column;align-items:center;gap:6px;font-size:12px;color:#A3802C;font-family:'Cinzel',serif;letter-spacing:0.15em;">
      <span>Central Florida · Orlando · Daytona · Cocoa</span>
      <span style="color:#FAF8F5;font-weight:500;">kimberly@kandrpix.com</span>
    </div>
  </div>

  <!-- Page Content -->
  <main>
    <slot />
  </main>

  <!-- Footer -->
  {!hideFooter && (
  <footer style="background:#F4F0EA;border-top:1px solid rgba(184,150,53,0.2);padding:80px 60px 48px;">
    <div style="max-width:1200px;margin:0 auto;">
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:60px;margin-bottom:60px;" class="footer-grid">
        <div style="grid-column:span 2;" class="footer-brand">
          <div class="footer-logo-title">K&amp;R PHOTOGRAPHY</div>
          <div style="font-family:'Cinzel',serif;font-size:12px;letter-spacing:0.35em;color:#7A5B18;margin-bottom:20px;font-weight:700;">KIMBERLY & RICK • EST. 2004</div>
          <p style="font-size:15px;line-height:1.75;color:#2E2A25;max-width:340px;font-weight:400;">A husband-and-wife photography studio serving weddings, portraits, and luxury real estate across Central Florida for over 20 years.</p>
          <div style="display:inline-flex;align-items:center;gap:14px;margin-top:24px;background:#FFFFFF;border:1px solid rgba(184,150,53,0.3);padding:16px 22px;border-radius:12px;box-shadow:0 8px 25px rgba(26,24,22,0.04);">
            <span style="color:#A3802C;font-size:16px;">★★★★★</span>
            <div>
              <div style="font-size:13px;font-weight:700;color:#11100F;">380+ 5-Star Google Reviews</div>
              <div style="font-size:12px;color:#4D4741;margin-top:2px;font-weight:500;">Verified Client Reviews</div>
            </div>
          </div>
        </div>
        <div>
          <div style="font-family:'Cinzel',serif;font-size:12px;letter-spacing:0.28em;text-transform:uppercase;color:#7A5B18;margin-bottom:20px;font-weight:700;">Services</div>
          <div style="display:flex;flex-direction:column;gap:14px;">
            <a href="/weddings-and-couples" style="font-size:15px;color:#2E2A25;text-decoration:none;font-weight:500;transition:color 0.3s;" onmouseover="this.style.color='#11100F'" onmouseout="this.style.color='#2E2A25'">Weddings & Couples</a>
            <a href="/family-and-portraits" style="font-size:15px;color:#2E2A25;text-decoration:none;font-weight:500;transition:color 0.3s;" onmouseover="this.style.color='#11100F'" onmouseout="this.style.color='#2E2A25'">Family & Portraits</a>
            <a href="/real-estate" style="font-size:15px;color:#2E2A25;text-decoration:none;font-weight:500;transition:color 0.3s;" onmouseover="this.style.color='#11100F'" onmouseout="this.style.color='#2E2A25'">Real Estate Media</a>
            <a href="/packages" style="font-size:15px;color:#2E2A25;text-decoration:none;font-weight:500;transition:color 0.3s;" onmouseover="this.style.color='#11100F'" onmouseout="this.style.color='#2E2A25'">Pricing & Packages</a>
          </div>
        </div>
        <div>
          <div style="font-family:'Cinzel',serif;font-size:12px;letter-spacing:0.28em;text-transform:uppercase;color:#7A5B18;margin-bottom:20px;font-weight:700;">Studio</div>
          <div style="display:flex;flex-direction:column;gap:14px;">
            <a href="/contact" style="font-size:15px;color:#2E2A25;text-decoration:none;font-weight:500;" onmouseover="this.style.color='#11100F'" onmouseout="this.style.color='#2E2A25'">Book a Session</a>
            <a href="https://instagram.com/kandrpix" target="_blank" rel="noopener" style="font-size:15px;color:#2E2A25;text-decoration:none;font-weight:500;" onmouseover="this.style.color='#11100F'" onmouseout="this.style.color='#2E2A25'">Instagram @kandrpix</a>
            <a href="mailto:kimberly@kandrpix.com" style="font-size:15px;color:#2E2A25;text-decoration:none;font-weight:500;" onmouseover="this.style.color='#11100F'" onmouseout="this.style.color='#2E2A25'">kimberly@kandrpix.com</a>
          </div>
        </div>
      </div>
      <div style="border-top:1px solid rgba(184,150,53,0.18);padding-top:28px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;">
        <p style="font-size:13px;color:#2E2A25;font-weight:500;">© {new Date().getFullYear()} K&amp;R Photography · kandrpix.com</p>
        <div style="display:flex;align-items:center;gap:16px;font-size:12.5px;">
          <a href="/privacy" style="color:#4D4741;text-decoration:none;font-weight:600;transition:color 0.2s;" onmouseover="this.style.color='#11100F'" onmouseout="this.style.color='#4D4741'">Privacy Policy</a>
          <span style="color:#8B6914;font-size:10px;">•</span>
          <a href="/terms" style="color:#4D4741;text-decoration:none;font-weight:600;transition:color 0.2s;" onmouseover="this.style.color='#11100F'" onmouseout="this.style.color='#4D4741'">Terms &amp; Conditions</a>
        </div>
      </div>
    </div>
  </footer>
  )}

</body>
</html>

<style>
  /* ── Header Base & Responsive Layout ── */
  .header-logo {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex-shrink: 0;
  }
  .logo-title {
    font-family: 'Cinzel', serif;
    font-size: clamp(28px, 2.6vw, 36px);
    font-weight: 700;
    letter-spacing: 0.26em;
    color: #11100F;
    text-transform: uppercase;
    line-height: 1;
    white-space: nowrap;
  }
  .logo-sub {
    font-family: 'Cinzel', serif;
    font-size: clamp(10px, 0.95vw, 12.5px);
    font-weight: 700;
    letter-spacing: 0.35em;
    color: #7A5B18;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2.2vw, 38px);
    flex-shrink: 1;
  }

  .nav-link {
    white-space: nowrap;
  }

  .nav-link-dropdown-trigger {
    cursor: pointer;
    display: inline-flex;
    align-items: center;
  }

  .nav-dropdown-wrap {
    position: relative;
    padding-bottom: 12px;
    margin-bottom: -12px;
  }

  .nav-dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(184, 150, 53, 0.25);
    box-shadow: 0 15px 45px rgba(26, 24, 22, 0.08);
    border-radius: 12px;
    padding: 12px;
    width: 250px;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-8px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .nav-dropdown-link {
    display: block;
    padding: 10px 14px;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.2s;
  }

  .nav-dropdown-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 19px;
    font-weight: 500;
    color: #11100F;
  }

  .mobile-menu-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    z-index: 1002;
    position: relative;
  }

  .footer-logo-title {
    font-family: 'Cinzel', serif;
    font-size: clamp(22px, 5vw, 34px);
    letter-spacing: 0.28em;
    color: #11100F;
    margin-bottom: 6px;
    font-weight: 700;
  }
  .hide-mobile { display: flex; }
  .show-mobile { display: none !important; }

  /* ── Widescreen Tablet / iPad Landscape (901px - 1180px) ── */
  @media (max-width: 1180px) {
    .site-header {
      padding: 0 24px !important;
      height: 72px !important;
    }
    .desktop-nav {
      gap: 16px !important;
    }
    .nav-link {
      font-size: 12.5px !important;
      letter-spacing: 0.12em !important;
    }
    .cta-btn {
      padding: 10px 20px !important;
      font-size: 12px !important;
      letter-spacing: 0.14em !important;
    }
  }

  /* ── Small Tablet & Mobile Breakpoint (<= 960px) ── */
  @media (max-width: 960px) {
    .hide-mobile { display: none !important; }
    .show-mobile { display: flex !important; }
    #mobile-toggle { display: flex !important; }
    .footer-grid { grid-template-columns: 1fr 1fr !important; }
    .footer-brand { grid-column: span 2 !important; }
    footer { padding: 50px 24px 36px !important; }
    .footer-logo-title {
      font-size: 22px !important;
      letter-spacing: 0.14em !important;
    }
  }
  .nav-dropdown-wrap:hover .nav-dropdown {
    opacity: 1 !important;
    pointer-events: all !important;
    transform: translateY(0) !important;
  }
  .nav-dropdown-wrap:hover .nav-caret {
    transform: rotate(180deg);
  }
  .nav-dropdown a:hover { background: rgba(201,168,76,0.08); }
</style>

<script>
  // ─── HEADER SCROLL ───
  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    if (header) {
      header.classList.toggle('scrolled', window.scrollY > 60);
    }
  }, { passive: true });

  // ─── MOBILE MENU ───
  const toggle = document.getElementById('mobile-toggle');
  const drawer = document.getElementById('mobile-drawer');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');
  let drawerOpen = false;

  toggle?.addEventListener('click', () => {
    drawerOpen = !drawerOpen;
    if (drawer) drawer.style.display = drawerOpen ? 'flex' : 'none';
    if (iconMenu) iconMenu.style.display = drawerOpen ? 'none' : 'block';
    if (iconClose) iconClose.style.display = drawerOpen ? 'block' : 'none';
    document.body.style.overflow = drawerOpen ? 'hidden' : '';
  });

  drawer?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      drawerOpen = false;
      if (drawer) drawer.style.display = 'none';
      if (iconMenu) iconMenu.style.display = 'block';
      if (iconClose) iconClose.style.display = 'none';
      document.body.style.overflow = '';
    });
  });

  // ─── SCROLL REVEAL ───
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -60px 0px' });

  document.querySelectorAll('.reveal, .reveal-left, .reveal-right, .stagger-children, .img-wipe, .word-reveal').forEach(el => {
    observer.observe(el);
  });

  // ─── HERO BG LOAD ANIMATION ───
  document.querySelectorAll('.hero-bg').forEach(el => {
    const img = new Image();
    const src = (el as HTMLElement).style.backgroundImage.replace(/url\(["']?(.*?)["']?\)/, '$1');
    img.onload = () => el.classList.add('loaded');
    img.src = src;
  });
</script>
