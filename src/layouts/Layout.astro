---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  hideFooter?: boolean;
}

const {
  title = "K&R Photography | Weddings, Portraits & Real Estate | Central Florida",
  description = "Central Florida's premier husband-and-wife photography studio. 20+ years experience. 380+ 5-star Google reviews. Weddings, family portraits & real estate across Central Florida.",
  image = "/weddings/KIM_8014-2_result.webp",
  type = "website",
  hideFooter = false
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://kandrpix.com');
const socialImageURL = new URL(image, Astro.site || 'https://kandrpix.com');

const schemaData = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "K&R Photography",
  "legalName": "K&R Photography LLC",
  "founders": [
    { "@type": "Person", "name": "Kimberly" },
    { "@type": "Person", "name": "Rick" }
  ],
  "image": "https://kandrpix.com/weddings/KIM_8014-2_result.webp",
  "url": "https://kandrpix.com",
  "telephone": "+14074979239",
  "email": "kimberly@kandrpix.com",
  "priceRange": "$$$",
  "address": {
    "@type": "PostalAddress",
    "addressRegion": "FL",
    "addressCountry": "US"
  },
  "areaServed": [
    { "@type": "City", "name": "Orlando" },
    { "@type": "City", "name": "Winter Park" },
    { "@type": "City", "name": "Cocoa Beach" },
    { "@type": "City", "name": "Daytona Beach" },
    { "@type": "City", "name": "Windermere" },
    { "@type": "City", "name": "Kissimmee" },
    { "@type": "State", "name": "Central Florida" }
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "bestRating": "5.0",
    "ratingCount": "380",
    "reviewCount": "380"
  },
  "sameAs": [
    "https://instagram.com/kandrpix",
    "https://www.google.com/search?q=K%26R+Photography+Orlando"
  ]
};
