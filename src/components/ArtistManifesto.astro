---
---

<section class="py-28 bg-[#080706] text-white relative overflow-hidden border-t border-amber-400/20">
  
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Left Column: Portrait & Exhibition Frame -->
      <div class="lg:col-span-5 relative">
        <div class="relative rounded-2xl overflow-hidden art-card p-3 border border-amber-400/30">
          <div class="relative overflow-hidden rounded-xl aspect-[4/5] bg-[#12100E]">
            <img 
              src="/kim and rick.webp" 
              alt="Kimberly & Rick - Studio Co-Founders" 
              class="w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#080706] via-transparent to-transparent opacity-80"></div>
            
            <div class="absolute bottom-6 left-6 right-6 text-center space-y-1">
              <span class="font-cinzel text-xs uppercase tracking-[0.25em] text-amber-300">Kimberly & Rick</span>
              <p class="text-[10px] text-brand-300 uppercase tracking-widest">Co-Founders & Lead Photographers</p>
            </div>
          </div>
        </div>

        <div class="absolute -bottom-6 -right-6 museum-plaque px-6 py-4 rounded-xl border border-amber-400/30 text-center hidden sm:block">
          <span class="font-editorial text-3xl font-light text-amber-300">Est. 2004</span>
          <span class="block text-[9px] font-cinzel uppercase tracking-[0.2em] text-brand-300">Two Decades of Craft</span>
        </div>
      </div>

      <!-- Right Column: Artist Manifesto & Philosophy -->
      <div class="lg:col-span-7 space-y-8">
        
        <div class="space-y-3">
          <span class="font-cinzel text-xs uppercase tracking-[0.3em] text-amber-300 font-medium">
            The Studio Philosophy
          </span>
          <h2 class="font-editorial text-4xl sm:text-6xl text-white font-light leading-tight">
            "Light fades in seconds. <br />
            <span class="italic text-gold-metallic">Art preserves it forever."</span>
          </h2>
        </div>

        <div class="space-y-5 text-brand-300 text-base font-sans font-light leading-relaxed">
          <p>
            We do not view photography as transactional documentation. For over twenty years, our studio has approached weddings, portraiture, and architectural spaces with timeless gallery craftsmanship.
          </p>
          <p>
            Working as a husband-and-wife duo allows us to see what single photographers miss—balancing technical precision in ambient lighting with soft, emotional storytelling. We seek natural luminescence, candid intimacy, and timeless composition over fleeting trends.
          </p>
        </div>

        <!-- Studio Pillars -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-4 border-t border-amber-400/20 text-xs">
          <div class="space-y-1">
            <div class="font-cinzel text-amber-300 font-semibold tracking-wider uppercase">01. Dual Lenses</div>
            <p class="text-brand-400">Simultaneous wide & close-up emotional perspectives.</p>
          </div>
          <div class="space-y-1">
            <div class="font-cinzel text-amber-300 font-semibold tracking-wider uppercase">02. Luminescence</div>
            <p class="text-brand-400">Mastered natural light & flambient HDR window clarity.</p>
          </div>
          <div class="space-y-1">
            <div class="font-cinzel text-amber-300 font-semibold tracking-wider uppercase">03. Permanence</div>
            <p class="text-brand-400">High-resolution heirloom archival gallery deliverables.</p>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
