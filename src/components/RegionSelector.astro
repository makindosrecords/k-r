---
const regions = [
  {
    id: 'orlando',
    name: 'Orlando & Winter Park',
    tagline: 'Lush Botanical Gardens, Historic Estates & Luxury Venues',
    image: '/weddings/KIM_8018_result.webp',
    stats: '160+ Weddings & Estates Shot',
    review: 'Kimberly & Rick made our Winter Park estate wedding feel like a scene from a movie!',
    reviewer: 'Sonialy R. • Orlando, FL',
  },
  {
    id: 'daytona',
    name: 'Daytona Beach & Volusia',
    tagline: 'Coastal Sunset Flares, Oceanfront Dunes & Historic Pier Shoots',
    image: '/family/KIM_7258_result.webp',
    stats: '140+ Coastal & Family Sessions',
    review: 'Hands down the best photographers in Daytona. They handled our family session effortlessly!',
    reviewer: 'Sharon M. • Daytona Beach, FL',
  },
  {
    id: 'cocoa',
    name: 'Cocoa Beach & Space Coast',
    tagline: 'Golden Hour Waves, Oceanfront Architectural Real Estate & Weddings',
    image: '/real%20estate/AEC_4701_result.webp',
    stats: '80+ Luxury Real Estate & Beach Shoots',
    review: 'Our Cocoa Beach listing sold in 48 hours thanks to Kimberly & Rick’s flambient HDR media.',
    reviewer: 'Maria G. • Cocoa Beach, FL',
  },
];
---

<section class="py-24 bg-brand-900 text-white relative overflow-hidden border-t border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="text-center max-w-3xl mx-auto mb-14 space-y-3">
      <div class="inline-flex items-center space-x-2 px-4 py-1.5 rounded-full glass-card-dark text-[11px] uppercase tracking-[0.25em] text-amber-300 font-semibold border border-amber-400/30">
        <span>Localized Central FL Expertise</span>
      </div>
      <h2 class="font-editorial text-4xl sm:text-6xl text-white font-light">
        Serving Central Florida’s Most Iconic Locations
      </h2>
      <p class="text-brand-300 text-sm font-sans">
        Select a region below to see localized portfolio proof and client reviews.
      </p>
    </div>

    <!-- Region Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {regions.map(r => (
        <div class="group rounded-3xl overflow-hidden glass-card-dark border border-white/10 hover:border-amber-400/40 transition-all duration-500 hover:-translate-y-2 flex flex-col justify-between">
          <div class="relative h-60 overflow-hidden">
            <img src={r.image} alt={r.name} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 pointer-events-none" />
            <div class="absolute inset-0 bg-gradient-to-t from-brand-950 via-brand-950/20 to-transparent"></div>
            <div class="absolute bottom-4 left-4 right-4">
              <span class="text-[10px] uppercase tracking-widest text-amber-300 font-semibold px-2.5 py-1 rounded-full bg-brand-950/80 border border-amber-400/30">
                {r.stats}
              </span>
              <h3 class="font-editorial text-2xl text-white font-bold mt-2">{r.name}</h3>
            </div>
          </div>

          <div class="p-6 space-y-4 flex-grow flex flex-col justify-between">
            <p class="text-xs text-brand-300 leading-relaxed font-sans">{r.tagline}</p>
            
            <div class="p-4 rounded-xl bg-white/5 border border-white/10 space-y-2">
              <p class="text-xs text-amber-200 italic">"{r.review}"</p>
              <div class="text-[10px] text-brand-400 uppercase tracking-wider">{r.reviewer}</div>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
