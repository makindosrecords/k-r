---
export interface GalleryItem {
  id: string;
  title: string;
  category: string;
  location: string;
  image: string;
  plateNumber?: string;
  aspectRatio?: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  items: GalleryItem[];
}

const {
  title = "Selected Works",
  subtitle = "Featured Works • Click any photograph to enter the gallery exhibition",
  items = []
} = Astro.props;

const categories = ["All Works", ...Array.from(new Set(items.map(i => i.category)))];
---

<section class="py-28 bg-[#080706] text-white relative overflow-hidden gallery-section">
  
  <!-- Subtle Ambient Glow -->
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[700px] h-[700px] bg-amber-500/10 rounded-full blur-[140px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-16 pb-8 border-b border-amber-400/20">
      <div class="space-y-3">
        <div class="inline-flex items-center space-x-3 text-xs uppercase tracking-[0.3em] text-amber-300 font-cinzel font-medium">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
          <span>{subtitle}</span>
        </div>
        <h2 class="font-editorial text-4xl sm:text-6xl text-white font-light tracking-wide">
          {title}
        </h2>
      </div>

      <!-- Exhibition Filters -->
      <div class="flex flex-wrap items-center gap-3">
        {categories.map((cat, idx) => (
          <button 
            type="button"
            class={`gallery-filter-btn px-6 py-2.5 rounded-full text-xs uppercase tracking-[0.2em] font-medium transition-all duration-500 ${idx === 0 ? 'bg-amber-400 text-[#080706] font-semibold shadow-lg shadow-amber-400/20' : 'bg-white/5 text-brand-300 hover:text-white border border-white/10 hover:border-amber-400/40'}`}
            data-category={cat}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>

    <!-- Fine Art Atelier Grid -->
    <div class="gallery-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 sm:gap-10">
      {items.map((item, index) => (
        <div 
          class="gallery-item-card group relative art-card rounded-2xl overflow-hidden cursor-pointer"
          data-category={item.category}
          data-index={index}
          data-title={item.title}
          data-location={item.location}
          data-image={item.image}
          data-plate={`PLATE ${String(index + 1).padStart(2, '0')}`}
        >
          <div class={`relative overflow-hidden bg-[#12100E] ${item.aspectRatio || 'aspect-[4/5]'}`}>
            <img 
              src={item.image} 
              alt={item.title} 
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-1000 ease-out pointer-events-none"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#080706] via-[#080706]/20 to-transparent opacity-70 group-hover:opacity-90 transition-opacity duration-500 pointer-events-none"></div>
            
            <!-- Fine Art Plate Number Pill -->
            <div class="absolute top-5 left-5 font-cinzel text-[10px] uppercase tracking-[0.25em] text-amber-300 bg-[#080706]/80 px-3.5 py-1.5 rounded-full backdrop-blur-md border border-amber-400/30">
              PLATE {String(index + 1).padStart(2, '0')}
            </div>

            <!-- Quick View Icon -->
            <div class="absolute top-5 right-5 w-9 h-9 rounded-full bg-[#080706]/80 text-amber-300 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300 border border-amber-400/30">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
              </svg>
            </div>

            <!-- Artwork Title & Plaque -->
            <div class="absolute bottom-0 left-0 right-0 p-6 text-white space-y-1.5 pointer-events-none transform group-hover:-translate-y-1 transition-transform duration-500">
              <div class="text-[10px] uppercase tracking-[0.25em] text-amber-400 font-cinzel">
                {item.category} • {item.location}
              </div>
              <h3 class="font-editorial text-2xl font-normal text-white group-hover:text-amber-100 transition-colors">
                {item.title}
              </h3>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>

  <!-- DARKROOM EXHIBITION LIGHTBOX DIALOG -->
  <dialog 
    class="lightbox-dialog fixed inset-0 w-screen h-screen m-0 p-0 border-0 max-w-none max-h-none bg-[#080706]/98 text-white backdrop:bg-black/95 backdrop:backdrop-blur-2xl flex-col justify-between overflow-hidden"
    aria-label="High-resolution photo viewer"
  >
    <!-- Darkroom Top Bar -->
    <div class="p-6 flex items-center justify-between text-white border-b border-amber-400/20 shrink-0">
      <div class="flex items-center space-x-4">
        <span class="font-cinzel text-xl tracking-[0.25em] text-amber-300 font-semibold">K&R PHOTOGRAPHY</span>
        <span class="text-white/20">•</span>
        <span class="lightbox-plate font-cinzel text-xs tracking-widest text-amber-400/80">PLATE 01</span>
        <span class="text-white/20">•</span>
        <span class="lightbox-counter text-xs uppercase tracking-widest text-brand-300">1 of {items.length}</span>
      </div>

      <button 
        type="button"
        class="lightbox-close p-3 rounded-full bg-white/5 hover:bg-amber-400 hover:text-[#080706] text-white transition-all duration-300 focus:outline-none cursor-pointer border border-white/10"
        aria-label="Close exhibition viewer"
      >
        <svg class="w-6 h-6 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Main Artwork Display -->
    <div class="relative flex-grow flex items-center justify-center p-4 sm:p-8 min-h-0 overflow-hidden">
      
      <!-- Prev Button -->
      <button 
        type="button"
        class="lightbox-prev absolute left-4 sm:left-10 z-20 p-4 rounded-full bg-black/70 hover:bg-amber-400 hover:text-[#080706] text-white backdrop-blur-md transition-all duration-300 focus:outline-none cursor-pointer border border-amber-400/20 active:scale-90"
        aria-label="Previous photograph"
      >
        <svg class="w-7 h-7 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <!-- Center Image -->
      <div class="max-w-6xl max-h-full relative flex items-center justify-center p-2">
        <img 
          class="lightbox-img max-w-full max-h-[72vh] w-auto h-auto object-contain rounded-lg shadow-2xl transition-all duration-500 border border-white/10" 
          src="" 
          alt="" 
        />
      </div>

      <!-- Next Button -->
      <button 
        type="button"
        class="lightbox-next absolute right-4 sm:right-10 z-20 p-4 rounded-full bg-black/70 hover:bg-amber-400 hover:text-[#080706] text-white backdrop-blur-md transition-all duration-300 focus:outline-none cursor-pointer border border-amber-400/20 active:scale-90"
        aria-label="Next photograph"
      >
        <svg class="w-7 h-7 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>

    <!-- Museum Exhibition Plaque & Thumbnail Bar -->
    <div class="p-6 text-center text-white border-t border-amber-400/20 bg-black/70 backdrop-blur-xl space-y-4 shrink-0">
      <div class="space-y-1">
        <h4 class="lightbox-title font-editorial text-2xl sm:text-3xl text-amber-200"></h4>
        <p class="lightbox-meta text-xs uppercase tracking-[0.25em] text-brand-300 font-cinzel"></p>
      </div>

      <!-- Filmstrip Thumbnails -->
      <div class="lightbox-thumbnails flex items-center justify-center space-x-3 overflow-x-auto py-1 max-w-2xl mx-auto scrollbar-none">
        {items.map((item, idx) => (
          <button 
            type="button"
            class="lightbox-thumb-btn w-12 h-12 rounded-lg overflow-hidden border-2 border-white/20 hover:border-amber-400 transition-all opacity-50 hover:opacity-100 shrink-0 cursor-pointer"
            data-index={idx}
          >
            <img src={item.image} alt={item.title} class="w-full h-full object-cover pointer-events-none" />
          </button>
        ))}
      </div>
    </div>
  </dialog>
</section>

<script is:inline>
  (function initAtelierGallery() {
    function setupGalleries() {
      const sections = document.querySelectorAll('.gallery-section');

      sections.forEach(section => {
        const dialog = section.querySelector('.lightbox-dialog');
        const modalImg = section.querySelector('.lightbox-img');
        const modalTitle = section.querySelector('.lightbox-title');
        const modalMeta = section.querySelector('.lightbox-meta');
        const modalCounter = section.querySelector('.lightbox-counter');
        const modalPlate = section.querySelector('.lightbox-plate');
        const closeBtn = section.querySelector('.lightbox-close');
        const lbPrev = section.querySelector('.lightbox-prev');
        const lbNext = section.querySelector('.lightbox-next');
        const filterBtns = section.querySelectorAll('.gallery-filter-btn');
        const cards = Array.from(section.querySelectorAll('.gallery-item-card'));
        const thumbBtns = section.querySelectorAll('.lightbox-thumb-btn');

        if (!dialog || !modalImg) return;

        let activeItems = [...cards];
        let currentIndex = 0;

        function updateLightbox(idx) {
          if (idx < 0) idx = activeItems.length - 1;
          if (idx >= activeItems.length) idx = 0;
          currentIndex = idx;
          const targetCard = activeItems[currentIndex];

          if (targetCard) {
            const img = targetCard.getAttribute('data-image') || '';
            const title = targetCard.getAttribute('data-title') || '';
            const category = targetCard.getAttribute('data-category') || '';
            const location = targetCard.getAttribute('data-location') || '';
            const plate = targetCard.getAttribute('data-plate') || 'PLATE 01';

            modalImg.src = img;
            modalImg.alt = title;
            if (modalTitle) modalTitle.textContent = title;
            if (modalMeta) modalMeta.textContent = `${category} • ${location}`;
            if (modalCounter) modalCounter.textContent = `${currentIndex + 1} of ${activeItems.length}`;
            if (modalPlate) modalPlate.textContent = plate;

            thumbBtns.forEach((tb) => {
              const tbCardIdx = parseInt(tb.getAttribute('data-index') || '0', 10);
              const originalCardIdx = parseInt(targetCard.getAttribute('data-index') || '0', 10);
              if (tbCardIdx === originalCardIdx) {
                tb.classList.add('border-amber-400', 'opacity-100', 'scale-110');
                tb.classList.remove('border-white/20', 'opacity-50');
              } else {
                tb.classList.remove('border-amber-400', 'opacity-100', 'scale-110');
                tb.classList.add('border-white/20', 'opacity-50');
              }
            });
          }
        }

        cards.forEach((card) => {
          card.addEventListener('click', (e) => {
            e.preventDefault();
            const cardIdxInActive = activeItems.indexOf(card);
            updateLightbox(cardIdxInActive >= 0 ? cardIdxInActive : 0);
            dialog.style.display = 'flex';
            if (dialog.showModal) dialog.showModal();
            document.body.style.overflow = 'hidden';
          });
        });

        thumbBtns.forEach((tb) => {
          tb.addEventListener('click', (e) => {
            e.stopPropagation();
            const rawIdx = parseInt(tb.getAttribute('data-index') || '0', 10);
            const targetCard = cards[rawIdx];
            const cardIdxInActive = activeItems.indexOf(targetCard);
            if (cardIdxInActive >= 0) {
              updateLightbox(cardIdxInActive);
            }
          });
        });

        filterBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            const cat = btn.getAttribute('data-category');
            
            filterBtns.forEach(b => {
              b.classList.remove('bg-amber-400', 'text-[#080706]', 'shadow-lg', 'shadow-amber-400/20');
              b.classList.add('bg-white/5', 'text-brand-300');
            });
            btn.classList.add('bg-amber-400', 'text-[#080706]', 'shadow-lg', 'shadow-amber-400/20');
            btn.classList.remove('bg-white/5', 'text-brand-300');

            activeItems = [];
            cards.forEach(card => {
              const cardCat = card.getAttribute('data-category');
              if (cat === 'All Works' || cardCat === cat) {
                card.style.display = 'block';
                activeItems.push(card);
              } else {
                card.style.display = 'none';
              }
            });
          });
        });

        function closeDialog() {
          if (dialog.close) dialog.close();
          dialog.style.display = 'none';
          document.body.style.overflow = '';
        }

        if (closeBtn) closeBtn.addEventListener('click', closeDialog);
        dialog.addEventListener('click', (e) => { if (e.target === dialog) closeDialog(); });
        dialog.addEventListener('cancel', () => { dialog.style.display = 'none'; document.body.style.overflow = ''; });

        if (lbPrev) lbPrev.addEventListener('click', (e) => { e.stopPropagation(); updateLightbox(currentIndex - 1); });
        if (lbNext) lbNext.addEventListener('click', (e) => { e.stopPropagation(); updateLightbox(currentIndex + 1); });

        window.addEventListener('keydown', (e) => {
          if (!dialog.open && dialog.style.display !== 'flex') return;
          if (e.key === 'ArrowLeft') updateLightbox(currentIndex - 1);
          if (e.key === 'ArrowRight') updateLightbox(currentIndex + 1);
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupGalleries);
    } else {
      setupGalleries();
    }
  })();
</script>
