---
import Layout from '../layouts/Layout.astro';
import EditorialGallery from '../components/EditorialGallery.astro';

const galleryItems = [
  { number: '01', title: 'Shoreline Family Sitting',    location: 'CENTRAL FLORIDA', type: 'portrait' as const, image: '/family/KIM_7294_result.webp', badge: '380+ 5-STAR REVIEWS' },
  { number: '02', title: 'Coastal Family Joy',          location: 'CENTRAL FLORIDA', type: 'wide'     as const, image: '/family/KIM_8655_result.webp', badge: 'EDITORIAL SELECTION' },
  { number: '03', title: 'Arbor Walkway Family',        location: 'CENTRAL FLORIDA', type: 'portrait' as const, image: '/family/KIM_6504_result.webp' },
  { number: '04', title: 'Sand Dunes Family Session',   location: 'CENTRAL FLORIDA', type: 'wide'     as const, image: '/family/KIM_3497_result.webp' },
  { number: '05', title: 'Beach Running Family Motion', location: 'CENTRAL FLORIDA', type: 'portrait' as const, image: '/family/KIM_7258_result.webp' },
  { number: '06', title: 'Sunset Dunes Family Stroll',  location: 'CENTRAL FLORIDA', type: 'wide'     as const, image: '/family/KIM_6988_result.webp' },
  { number: '07', title: 'Lush Garden Family Joy',      location: 'CENTRAL FLORIDA', type: 'portrait' as const, image: '/family/KIM_8221_result.webp' },
  { number: '08', title: 'Pastel Shoreline Family Walk',location: 'CENTRAL FLORIDA', type: 'wide'     as const, image: '/family/KIM_7250-2_result.webp' },
  { number: '09', title: 'Golden Hour Dune Portrait',   location: 'CENTRAL FLORIDA', type: 'portrait' as const, image: '/family/KIM_6853-2_result.webp' },
  { number: '10', title: 'Courtyard Family Gathering',  location: 'CENTRAL FLORIDA', type: 'wide'     as const, image: '/family/KIM_8718_result.webp' },
  { number: '11', title: 'Sand Dune Family Smile',      location: 'CENTRAL FLORIDA', type: 'portrait' as const, image: '/family/KIM_7349_result.webp' },
  { number: '12', title: 'Beach Dune Family Love',      location: 'CENTRAL FLORIDA', type: 'wide'     as const, image: '/family/KIM_2391_result.webp' },
  { number: '13', title: 'Warm Sunset Shoreline Moments', location: 'CENTRAL FLORIDA', type: 'portrait' as const, image: '/family/KIM_6818_result.webp' },
  { number: '14', title: 'Parents & Children Beach Silhouette', location: 'CENTRAL FLORIDA', type: 'wide' as const, image: '/family/KIM_7268_result.webp' },
  { number: '15', title: 'Three Brothers Beach Hug',    location: 'CENTRAL FLORIDA', type: 'wide'     as const, image: '/family/KIM_8930_result.webp' },
];
---

<Layout
  title="Family & Portrait Photography | K&R Photography"
  description="Golden hour family, maternity, portrait and lifestyle photography across Central Florida. Book a session with Kimberly & Rick — 380+ 5-star reviews."
  image="/family/KIM_7258_result.webp"
>

  <!-- ─── HERO ─── -->
  <section class="hero">
    <div class="hero-bg" style="background-image:url('/family/KIM_7258_result.webp');"></div>
    <div class="hero-vignette"></div>
    <div class="hero-content">
      <div class="hero-eyebrow">Family & Portraits · Golden Hour Sessions · Central Florida</div>
      <h1 class="hero-title">
        <span class="line"><span>Every Family</span></span>
        <span class="line"><span>Has a <em>Beautiful Story</em></span></span>
      </h1>
      <div class="hero-meta">
        <div class="hero-stat"><strong>Beach</strong>Sessions</div>
        <div class="hero-divider"></div>
        <div class="hero-stat"><strong>Studio</strong>Available</div>
        <div class="hero-divider"></div>
        <div style="margin-left:auto;"><a href="/contact" class="cta-btn">Book a Session</a></div>
      </div>
    </div>
  </section>

  <!-- ─── EDITORIAL GALLERY ─── -->
  <EditorialGallery
    tagline="PORTRAITS, FAMILY & LIFESTYLE"
    items={galleryItems}
    sectionId="portraits"
  />

  <!-- ─── SESSION DISCIPLINES CAROUSEL ─── -->
  <section class="sessions-carousel-section" style="background:var(--black-soft);padding:100px 40px 120px;border-top:1px solid rgba(184,150,53,0.18);border-bottom:1px solid rgba(184,150,53,0.18);position:relative;">
    <div style="max-width:1380px;margin:0 auto;">
      
      <!-- Section Header -->
      <div class="reveal" style="text-align:center;max-width:760px;margin:0 auto 52px;">
        <span style="font-family:'Cinzel',serif;font-size:12.5px;font-weight:700;letter-spacing:0.26em;text-transform:uppercase;color:#A3802C;display:inline-block;margin-bottom:8px;">
          <span class="gold-line"></span>Session Disciplines
        </span>
        <h2 style="font-family:'Cormorant Garamond',serif;font-size:clamp(38px,4.5vw,58px);font-weight:300;color:#11100F;margin-top:8px;line-height:1.05;">
          Every Chapter of <em style="font-style:italic;color:#A3802C;">Life</em>
        </h2>
        <p style="font-size:15.5px;color:#4D4741;margin-top:10px;font-weight:400;line-height:1.6;">
          Scroll through our fine art disciplines — from barefoot coastal evenings to intimate maternity, newborn milestones, and executive branding.
        </p>
      </div>

      <!-- Carousel Container with Flanking Arrows -->
      <div class="disciplines-carousel-container reveal">
        <button class="disc-nav-btn disc-prev-btn" id="discPrev" aria-label="Previous discipline">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M15 19l-7-7 7-7"/>
          </svg>
        </button>

        <div class="disciplines-track-wrap" id="discTrackWrap">
          <div class="disciplines-track">
            {[
              {
                num: 'I',
                tag: 'Coastal & Generational',
                title: 'Family & Lifestyle',
                desc: 'Golden hour beach & lifestyle imagery for families of all sizes across Daytona, New Smyrna, and Cocoa Beach. Natural interaction with zero stiff posing.',
                image: '/family/KIM_7258_result.webp',
                href: '/contact',
                cta: 'Inquire Family'
              },
              {
                num: 'II',
                tag: 'Ethereal & Timeless',
                title: 'Maternity & Motherhood',
                desc: 'Graceful, intimate maternity portraits celebrating the anticipation of new life against Florida’s glowing coastlines and scenic open fields.',
                image: '/k1%20(7)_result.webp',
                href: '/contact',
                cta: 'Inquire Maternity'
              },
              {
                num: 'III',
                tag: 'Tender & In-Home',
                title: 'Newborn Lifestyle',
                desc: 'Comfortable, in-home lifestyle sessions capturing tiny details and natural innocence in the first two weeks of life, in the calm of your own nursery.',
                image: '/DSC_0077-3_result.webp',
                href: '/contact',
                cta: 'Inquire Newborn'
              },
              {
                num: 'IV',
                tag: 'Editorial & Distinguished',
                title: 'Fine Art & Portraits',
                desc: 'Expressive studio and on-location portraiture with master lighting tailored for artists, actors, personal branding, and collector-grade artwork.',
                image: '/portraits/KIM_0864-3_result.webp',
                href: '/contact',
                cta: 'Inquire Portraits'
              },
              {
                num: 'V',
                tag: 'Dynamic & Celebratory',
                title: 'Senior Portraits',
                desc: 'Cinematic high school and college graduate portraits capturing authentic personality, passions, sports, music, and milestone energy.',
                image: '/DSC_0462-2_result.webp',
                href: '/contact',
                cta: 'Inquire Seniors'
              },
              {
                num: 'VI',
                tag: 'Confident & Polished',
                title: 'Executive Headshots',
                desc: 'High-definition commercial headshots and environmental media for top-tier listings, brokerages, attorneys, and corporate executive teams.',
                image: '/portraits/KIM_5247_result.webp',
                href: '/contact',
                cta: 'Inquire Headshots'
              },
            ].map((item) => (
              <a href={item.href} class="discipline-slide-card">
                <!-- Adaptive Museum Photo Frame (0% Cropping) -->
                <div class="discipline-photo-frame">
                  <img src={item.image} alt={item.title} class="discipline-main-img" loading="lazy" decoding="async" />
                  <div class="discipline-num-badge">{item.num}</div>
                </div>

                <!-- Card Body (Editorial Narrative) -->
                <div class="discipline-card-body">
                  <div>
                    <span class="discipline-card-tag">{item.tag}</span>
                    <h3 class="discipline-card-title">{item.title}</h3>
                    <p class="discipline-card-desc">{item.desc}</p>
                  </div>

                  <div class="discipline-card-footer">
                    <span class="discipline-card-cta">{item.cta}</span>
                    <div class="discipline-arrow-circle">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                      </svg>
                    </div>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>

        <button class="disc-nav-btn disc-next-btn" id="discNext" aria-label="Next discipline">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M9 5l7 7-7 7"/>
          </svg>
        </button>
      </div>

    </div>
  </section>

  <!-- ─── CTA ─── -->
  <section style="background:var(--black-soft);border-top:1px solid rgba(184,150,53,0.18);padding:120px 60px;text-align:center;" class="reveal">
    <span style="font-family:'Cinzel',serif;font-size:9px;letter-spacing:0.3em;text-transform:uppercase;color:var(--gold);display:block;margin-bottom:20px;"><span class="gold-line"></span>Reserve Your Session</span>
    <h2 style="font-family:'Cormorant Garamond',serif;font-size:clamp(44px,5vw,72px);font-weight:300;color:#1A1816;margin-bottom:24px;">Your Family.<br/><em style="font-style:italic;">Our Finest Art.</em></h2>
    <a href="/contact" class="cta-btn">Book a Portrait Session</a>
  </section>

</Layout>

<style>
  /* ─── DISCIPLINES CAROUSEL ─── */
  .disciplines-carousel-container {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    width: 100%;
  }

  .disc-nav-btn {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(184, 150, 53, 0.35);
    box-shadow: 0 6px 18px rgba(17, 16, 15, 0.1);
    color: #A3802C;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    z-index: 10;
    transition: all 0.35s var(--ease-out-expo);
  }

  .disc-nav-btn:hover {
    background: #A3802C;
    color: #FFFFFF;
    border-color: #A3802C;
    transform: scale(1.08);
    box-shadow: 0 8px 24px rgba(184, 150, 53, 0.3);
  }

  .disc-nav-btn:active {
    transform: scale(0.96);
  }

  .disciplines-track-wrap {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    width: 100%;
    padding: 14px 4px 22px;
  }

  .disciplines-track-wrap::-webkit-scrollbar {
    display: none;
  }

  .disciplines-track {
    display: flex;
    gap: 28px;
  }

  .discipline-slide-card {
    flex: 0 0 calc((100% - 56px) / 3);
    scroll-snap-align: start;
    background: #FFFFFF;
    border: 1px solid rgba(184, 150, 53, 0.22);
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: transform 0.45s var(--ease-out-expo), box-shadow 0.45s var(--ease-out-expo), border-color 0.35s ease;
    box-shadow: 0 10px 30px rgba(26, 24, 22, 0.04);
    position: relative;
  }

  .discipline-slide-card:hover {
    transform: translateY(-8px);
    border-color: rgba(184, 150, 53, 0.7);
    box-shadow: 0 22px 50px rgba(184, 150, 53, 0.16), 0 8px 24px rgba(17, 16, 15, 0.06);
  }

  /* Adaptive Museum Photo Frame */
  .discipline-photo-frame {
    position: relative;
    width: 100%;
    height: 300px;
    background: radial-gradient(circle at center, #25221E 0%, #11100F 100%);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid rgba(184, 150, 53, 0.18);
  }

  .discipline-main-img {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 16px;
    transition: transform 0.6s var(--ease-out-expo);
    filter: drop-shadow(0 10px 20px rgba(0, 0, 0, 0.45));
  }

  .discipline-slide-card:hover .discipline-main-img {
    transform: scale(1.04);
  }

  .discipline-num-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 3;
    font-family: 'Cinzel', serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #A3802C;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 4px 11px;
    border-radius: 20px;
    border: 1px solid rgba(184, 150, 53, 0.35);
    box-shadow: 0 4px 12px rgba(17, 16, 15, 0.08);
  }

  /* Card Body */
  .discipline-card-body {
    padding: 24px 22px 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1 1 auto;
    background: #FFFFFF;
  }

  .discipline-card-tag {
    font-family: 'Cinzel', serif;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #A3802C;
    display: block;
    margin-bottom: 5px;
  }

  .discipline-card-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 25px;
    font-weight: 600;
    color: #11100F;
    line-height: 1.15;
    margin: 0 0 8px 0;
  }

  .discipline-card-desc {
    font-size: 13.5px;
    line-height: 1.6;
    color: #4A443E;
    margin: 0 0 18px 0;
  }

  .discipline-card-footer {
    border-top: 1px solid rgba(184, 150, 53, 0.18);
    padding-top: 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .discipline-card-cta {
    font-family: 'Cinzel', serif;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #A3802C;
    transition: color 0.3s ease;
  }

  .discipline-arrow-circle {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(184, 150, 53, 0.1);
    border: 1px solid rgba(184, 150, 53, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #A3802C;
    transition: transform 0.35s var(--ease-out-expo), background 0.3s ease, color 0.3s ease;
  }

  .discipline-slide-card:hover .discipline-arrow-circle {
    transform: translateX(4px);
    background: #A3802C;
    color: #FFFFFF;
  }

  .discipline-slide-card:hover .discipline-card-cta {
    color: #7A5F1E;
  }

  @media (max-width: 1024px) {
    .discipline-slide-card {
      flex: 0 0 calc((100% - 28px) / 2) !important;
    }
  }

  @media (max-width: 640px) {
    .disciplines-carousel-container {
      gap: 8px !important;
    }
    .disc-nav-btn {
      display: none !important;
    }
    .discipline-slide-card {
      flex: 0 0 85% !important;
    }
    .discipline-photo-frame {
      height: 260px !important;
    }
  }
</style>

<script>
  const obs = new IntersectionObserver(entries => entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } }), { threshold: 0.12 });
  document.querySelectorAll('.reveal, .reveal-right, .stagger-children').forEach(el => obs.observe(el));

  // ─── DISCIPLINES CAROUSEL CONTROLLER ───
  const discTrackWrap = document.getElementById('discTrackWrap');
  const discPrev = document.getElementById('discPrev');
  const discNext = document.getElementById('discNext');

  if (discTrackWrap && discPrev && discNext) {
    const getCardWidth = () => {
      const card = discTrackWrap.querySelector('.discipline-slide-card') as HTMLElement;
      return card ? card.offsetWidth + 28 : 360;
    };

    discNext.addEventListener('click', () => {
      discTrackWrap.scrollBy({ left: getCardWidth(), behavior: 'smooth' });
    });

    discPrev.addEventListener('click', () => {
      discTrackWrap.scrollBy({ left: -getCardWidth(), behavior: 'smooth' });
    });
  }
</script>
