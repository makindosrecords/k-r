<script>
  // ─── CINEMATIC ARROW GALLERY ───
  const track = document.getElementById('gallery-track') as HTMLElement;
  const wrap = document.querySelector('.h-gallery-wrap') as HTMLElement;
  const btnPrev = document.getElementById('gal-prev') as HTMLButtonElement;
  const btnNext = document.getElementById('gal-next') as HTMLButtonElement;
  const counter = document.getElementById('gal-counter') as HTMLElement;
  const dotsEl = document.getElementById('gal-dots') as HTMLElement;
  const progressBar = document.getElementById('gal-progress-bar') as HTMLElement;
  const cursorPill = document.getElementById('gal-cursor-pill') as HTMLElement;
  const cursorText = document.getElementById('gal-cursor-text') as HTMLElement;

  if (track && wrap) {
    const cards = Array.from(track.querySelectorAll('.gallery-card')) as HTMLElement[];
    const total = cards.length;
    let currentCard = 0;
    
    // Cached layout offsets to eliminate frame-by-frame DOM queries / layout thrashing
    let cardCenters: number[] = [];
    let cardLefts: number[] = [];
    let cardWidths: number[] = [];
    let maxScroll = 0;

    function measureCards() {
      cardCenters = [];
      cardLefts = [];
      cardWidths = [];
      cards.forEach(c => {
        const left = c.offsetLeft;
        const w = c.offsetWidth;
        cardLefts.push(left);
        cardWidths.push(w);
        cardCenters.push(left + w / 2);
      });
      maxScroll = Math.max(0, wrap.scrollWidth - wrap.clientWidth);
    }

    // Build dot indicators
    cards.forEach((_, i) => {
      const dot = document.createElement('button');
      dot.style.cssText = 'width:26px;height:26px;border-radius:50%;border:none;cursor:pointer;transition:all 0.35s ease;padding:10px;background-clip:content-box;background-color:rgba(163,128,44,0.3);box-sizing:border-box;';
      dot.setAttribute('aria-label', `Photo ${i + 1}`);
      dot.addEventListener('click', () => goTo(i));
      dotsEl?.appendChild(dot);
    });

    function updateUI() {
      if (counter) counter.textContent = `${currentCard + 1} / ${total}`;
      if (btnPrev) {
        btnPrev.style.opacity = currentCard === 0 ? '0.35' : '1';
        btnPrev.style.pointerEvents = currentCard === 0 ? 'none' : 'auto';
      }
      if (btnNext) {
        btnNext.style.opacity = currentCard === total - 1 ? '0.35' : '1';
        btnNext.style.pointerEvents = currentCard === total - 1 ? 'none' : 'auto';
      }
      if (dotsEl) {
        dotsEl.querySelectorAll('button').forEach((d, i) => {
          const isActive = i === currentCard;
          (d as HTMLElement).style.width = isActive ? '44px' : '26px';
          (d as HTMLElement).style.borderRadius = isActive ? '14px' : '50%';
          (d as HTMLElement).style.backgroundColor = isActive ? '#A3802C' : 'rgba(163,128,44,0.3)';
        });
      }
      cards.forEach((c, i) => {
        if (i === currentCard) {
          c.classList.add('is-active');
        } else {
          c.classList.remove('is-active');
        }
      });
      if (progressBar) {
        const progress = maxScroll > 0 ? (wrap.scrollLeft / maxScroll) * 100 : 0;
        progressBar.style.width = `${Math.max(0, Math.min(100, progress))}%`;
      }
    }

    function syncActiveCard() {
      if (!cardCenters.length) measureCards();
      const wrapCenter = wrap.scrollLeft + wrap.clientWidth / 2;
      let minDiff = Infinity;
      let closest = 0;
      for (let i = 0; i < cardCenters.length; i++) {
        const diff = Math.abs(cardCenters[i] - wrapCenter);
        if (diff < minDiff) {
          minDiff = diff;
          closest = i;
        }
      }
      if (closest !== currentCard) {
        currentCard = closest;
        updateUI();
      } else if (progressBar) {
        const progress = maxScroll > 0 ? (wrap.scrollLeft / maxScroll) * 100 : 0;
        progressBar.style.width = `${Math.max(0, Math.min(100, progress))}%`;
      }
    }

    // Smooth programmatic scroll for buttons/dots
    let isProgrammatic = false;
    let animStart = 0;
    let startScroll = 0;
    let targetScroll = 0;
    let animDuration = 420;
    let progRaf = 0;

    function easeOutCubic(t: number): number {
      return 1 - Math.pow(1 - t, 3);
    }

    function smoothProgrammaticScroll(timestamp: number) {
      if (!animStart) animStart = timestamp;
      const elapsed = timestamp - animStart;
      const progress = Math.min(1, elapsed / animDuration);
      const ease = easeOutCubic(progress);

      wrap.scrollLeft = startScroll + (targetScroll - startScroll) * ease;
      syncActiveCard();

      if (progress < 1) {
        progRaf = requestAnimationFrame(smoothProgrammaticScroll);
      } else {
        wrap.scrollLeft = targetScroll;
        isProgrammatic = false;
        syncActiveCard();
      }
    }

    function goTo(idx: number) {
      if (!cardLefts.length) measureCards();
      currentCard = Math.max(0, Math.min(total - 1, idx));
      const wrapWidth = wrap.clientWidth;
      const cardLeft = cardLefts[currentCard] || 0;
      const cardWidth = cardWidths[currentCard] || 0;
      targetScroll = Math.max(0, Math.min(maxScroll, cardLeft - (wrapWidth - cardWidth) / 2));
      
      startScroll = wrap.scrollLeft;
      animStart = 0;
      isProgrammatic = true;
      cancelAnimationFrame(progRaf);
      cancelAnimationFrame(flingRaf);
      progRaf = requestAnimationFrame(smoothProgrammaticScroll);
      updateUI();
    }

    btnPrev?.addEventListener('click', () => goTo(currentCard - 1));
    btnNext?.addEventListener('click', () => goTo(currentCard + 1));

    // Zero-lag 1:1 Mouse Drag + Kinetic Fling
    let isDown = false;
    let isDragging = false;
    let totalDragDistance = 0;
    let startX = 0;
    let scrollStart = 0;
    let lastX = 0;
    let lastTime = 0;
    let velocity = 0;
    let flingRaf = 0;

    function applyFling() {
      if (Math.abs(velocity) > 0.4 && !isDown) {
        wrap.scrollLeft += velocity;
        velocity *= 0.93; // silky momentum decay
        syncActiveCard();
        flingRaf = requestAnimationFrame(applyFling);
      } else {
        velocity = 0;
      }
    }

    wrap.addEventListener('mousedown', (e) => {
      isDown = true;
      isDragging = false;
      totalDragDistance = 0;
      startX = e.pageX;
      scrollStart = wrap.scrollLeft;
      lastX = e.pageX;
      lastTime = performance.now();
      velocity = 0;
      cancelAnimationFrame(progRaf);
      cancelAnimationFrame(flingRaf);
      cancelAnimationFrame(wheelRaf);
      isProgrammatic = false;
      wrap.classList.add('is-dragging');
      if (cursorPill) {
        cursorPill.classList.add('dragging');
        if (cursorText) cursorText.textContent = 'DRAGGING';
      }
    });

    window.addEventListener('mousemove', (e) => {
      if (cursorPill && cursorPill.classList.contains('visible')) {
        cursorPill.style.left = `${e.clientX}px`;
        cursorPill.style.top = `${e.clientY}px`;
      }
      if (!isDown) return;

      const dx = e.pageX - startX;
      totalDragDistance += Math.abs(e.pageX - lastX);
      if (totalDragDistance > 6) {
        isDragging = true;
      }

      // Direct zero-lag 1:1 scroll tracking
      wrap.scrollLeft = scrollStart - dx;
      syncActiveCard();

      const now = performance.now();
      const dt = now - lastTime;
      if (dt > 8) {
        velocity = ((lastX - e.pageX) / dt) * 15;
        lastX = e.pageX;
        lastTime = now;
      }
    });

    const endDrag = () => {
      if (!isDown) return;
      isDown = false;
      wrap.classList.remove('is-dragging');
      if (cursorPill) {
        cursorPill.classList.remove('dragging');
        if (cursorText) cursorText.textContent = 'DRAG · EXPLORE';
      }
      if (Math.abs(velocity) > 0.5) {
        flingRaf = requestAnimationFrame(applyFling);
      }
    };

    window.addEventListener('mouseup', endDrag);
    wrap.addEventListener('mouseleave', () => {
      if (cursorPill) cursorPill.classList.remove('visible');
      if (isDown) endDrag();
    });

    wrap.addEventListener('mouseenter', (e) => {
      if (cursorPill && window.matchMedia('(pointer: fine)').matches) {
        cursorPill.style.left = `${e.clientX}px`;
        cursorPill.style.top = `${e.clientY}px`;
        cursorPill.classList.add('visible');
      }
    });

    // Smooth Kinetic Mouse Wheel with Smart Boundary Release
    let wheelVelocity = 0;
    let wheelRaf = 0;

    function applyWheelVelocity() {
      if (Math.abs(wheelVelocity) > 0.4 && !isDown) {
        wrap.scrollLeft += wheelVelocity;
        wheelVelocity *= 0.90; // smooth wheel glide damping
        syncActiveCard();
        wheelRaf = requestAnimationFrame(applyWheelVelocity);
      } else {
        wheelVelocity = 0;
      }
    }

    wrap.addEventListener('wheel', (e) => {
      const isHorizontal = Math.abs(e.deltaX) > Math.abs(e.deltaY);
      const delta = isHorizontal ? e.deltaX : e.deltaY;
      
      const canScrollLeft = wrap.scrollLeft > 2;
      const canScrollRight = wrap.scrollLeft < maxScroll - 2;

      const scrollingRight = delta > 0;
      const scrollingLeft = delta < 0;

      if ((scrollingRight && canScrollRight) || (scrollingLeft && canScrollLeft)) {
        e.preventDefault();
        cancelAnimationFrame(progRaf);
        cancelAnimationFrame(flingRaf);
        cancelAnimationFrame(wheelRaf);
        wheelVelocity += delta * 0.45;
        wheelVelocity = Math.max(-35, Math.min(35, wheelVelocity));
        wheelRaf = requestAnimationFrame(applyWheelVelocity);
      }
    }, { passive: false });

    // Touch swipe for mobile
    let touchStartX = 0;
    wrap.addEventListener('touchstart', (e) => { touchStartX = e.touches[0].clientX; }, { passive: true });
    wrap.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - touchStartX;
      if (Math.abs(dx) > 50) goTo(currentCard + (dx < 0 ? 1 : -1));
    });

    // Native scroll sync (trackpad gestures)
    wrap.addEventListener('scroll', () => {
      if (!isProgrammatic && !isDown && wheelVelocity === 0 && velocity === 0) {
        syncActiveCard();
      }
    }, { passive: true });

    // Keyboard navigation
    window.addEventListener('keydown', (e) => {
      if (document.getElementById('kr-lightbox')?.classList.contains('lb-open')) return;
      if (e.key === 'ArrowLeft') goTo(currentCard - 1);
      if (e.key === 'ArrowRight') goTo(currentCard + 1);
    });

    window.addEventListener('resize', () => {
      measureCards();
      updateUI();
    });

    // Init (deferred to prevent layout thrashing on initial paint)
    const initGallery = () => {
      measureCards();
      goTo(0);
    };
    if ('requestIdleCallback' in window) {
      (window as any).requestIdleCallback(initGallery);
    } else {
      setTimeout(initGallery, 0);
    }

    // ── LIGHTBOX ──
    const galleryArr = cards.map((c, i) => ({
      index: i,
      image: c.getAttribute('data-image') || '',
      title: c.getAttribute('data-title') || '',
      cat: c.getAttribute('data-cat') || '',
      loc: c.getAttribute('data-loc') || '',
    }));

    let lb = document.getElementById('kr-lightbox');
    if (!lb) {
      lb = document.createElement('div');
      lb.id = 'kr-lightbox';
      lb.innerHTML = `
        <div class="lb-header">
          <div style="display:flex;align-items:center;gap:12px;">
            <span style="font-family:'Cinzel',serif;font-size:11px;letter-spacing:0.25em;color:#A3802C;font-weight:600;">K&amp;R PHOTOGRAPHY</span>
            <span style="width:1px;height:14px;background:rgba(163,128,44,0.3);"></span>
            <span id="lb-counter" style="font-family:'Cinzel',serif;font-size:11px;letter-spacing:0.18em;color:#3D3934;font-weight:600;"></span>
          </div>
          <button class="lb-close-btn lb-btn" id="lb-close" aria-label="Close">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
          </button>
        </div>
        <div class="lb-stage" id="lb-stage">
          <button class="lb-nav-btn prev lb-btn" id="lb-prev" aria-label="Previous">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <div class="lb-img-wrap" id="lb-img-wrap" style="display:flex;align-items:center;justify-content:center;width:100%;height:100%;pointer-events:none;">
            <img id="lb-stage-img" class="lb-stage-img" src="" alt="" style="pointer-events:all;" />
          </div>
          <button class="lb-nav-btn next lb-btn" id="lb-next" aria-label="Next">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
        <div class="lb-footer">
          <div class="lb-info-row" style="display:flex;justify-content:space-between;align-items:center;width:100%;">
            <div>
              <div id="lb-title" style="font-family:'Cormorant Garamond',serif;font-size:24px;font-weight:400;color:#11100F;"></div>
              <div id="lb-meta" style="font-family:'Cinzel',serif;font-size:10px;letter-spacing:0.2em;text-transform:uppercase;color:#A3802C;margin-top:4px;"></div>
            </div>
            <div style="font-family:'Cinzel',serif;font-size:9.5px;letter-spacing:0.16em;color:#5C5650;text-align:right;" class="hide-mobile">
              ← → Navigate &nbsp;·&nbsp; Esc Close
            </div>
          </div>
        </div>
      `;
      document.body.appendChild(lb);
    }

    const lbStageImg = lb.querySelector('#lb-stage-img') as HTMLImageElement;
    const lbTitle = lb.querySelector('#lb-title') as HTMLElement;
    const lbMeta = lb.querySelector('#lb-meta') as HTMLElement;
    const lbCounter = lb.querySelector('#lb-counter') as HTMLElement;

    let lbIdx = 0;

    function showImage(idx: number) {
      lbIdx = ((idx % total) + total) % total;
      const item = galleryArr[lbIdx];
      if (!item) return;

      if (lbStageImg) {
        lbStageImg.src = item.image;
        lbStageImg.alt = item.title;
      }
      if (lbTitle) lbTitle.textContent = item.title;
      if (lbMeta) lbMeta.textContent = `${item.cat} · ${item.loc}`;
      if (lbCounter) lbCounter.textContent = `${lbIdx + 1} / ${total}`;
    }

    function openLb(idx: number) {
      showImage(idx);
      lb!.classList.add('lb-open');
      document.body.style.overflow = 'hidden';
    }

    function closeLb() {
      lb!.classList.remove('lb-open');
      document.body.style.overflow = '';
    }

    cards.forEach((card, i) => {
      card.addEventListener('click', (e) => {
        if (isDragging || totalDragDistance > 8) {
          e.preventDefault();
          return;
        }
        e.preventDefault();
        openLb(i);
      });
    });

    lb.querySelector('#lb-close')?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeLb();
    });
    lb.querySelector('#lb-prev')?.addEventListener('click', (e) => {
      e.stopPropagation();
      showImage(lbIdx - 1);
    });
    lb.querySelector('#lb-next')?.addEventListener('click', (e) => {
      e.stopPropagation();
      showImage(lbIdx + 1);
    });

    lb.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.id === 'lb-stage' || target.id === 'kr-lightbox' || target.id === 'lb-img-wrap' || target.closest('#lb-close')) {
        closeLb();
      }
    });

    window.addEventListener('keydown', (e) => {
      if (!lb!.classList.contains('lb-open')) return;
      if (e.key === 'ArrowLeft') showImage(lbIdx - 1);
      if (e.key === 'ArrowRight') showImage(lbIdx + 1);
      if (e.key === 'Escape') closeLb();
    });

    let lbSwipeX = 0;
    lb.addEventListener('touchstart', (e) => { lbSwipeX = e.touches[0].clientX; }, { passive: true });
    lb.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - lbSwipeX;
      if (Math.abs(dx) > 40) showImage(lbIdx + (dx < 0 ? 1 : -1));
    });
  }

  // ─── TESTIMONIALS CAROUSEL CONTROLLER ───
  const testTrack = document.getElementById('testimonials-track');
  const testPrev = document.getElementById('test-prev');
  const testNext = document.getElementById('test-next');

  if (testTrack && testPrev && testNext) {
    const testCards = testTrack.querySelectorAll('.testimonial-card');

    const updateTestNav = () => {
      const scrollLeft = testTrack.scrollLeft;
      const maxScroll = testTrack.scrollWidth - testTrack.clientWidth;
      
      if (testPrev) (testPrev as HTMLButtonElement).disabled = scrollLeft <= 4;
      if (testNext) (testNext as HTMLButtonElement).disabled = scrollLeft >= maxScroll - 6;
    };

    testPrev.addEventListener('click', () => {
      const card = testCards[0] as HTMLElement;
      const scrollAmount = card ? card.offsetWidth + 28 : 380;
      testTrack.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
    });

    testNext.addEventListener('click', () => {
      const card = testCards[0] as HTMLElement;
      const scrollAmount = card ? card.offsetWidth + 28 : 380;
      testTrack.scrollBy({ left: scrollAmount, behavior: 'smooth' });
    });

    testTrack.addEventListener('scroll', updateTestNav, { passive: true });
    window.addEventListener('resize', updateTestNav, { passive: true });
    setTimeout(updateTestNav, 0);
  }

  // ─── PARALLAX HERO ───
  const heroBg = document.querySelector('.hero-bg') as HTMLElement;
  const ctaBgImg = document.querySelector('.cta-bg-img') as HTMLElement;

  if (heroBg) {
    // Trigger loaded zoom transition
    requestAnimationFrame(() => {
      setTimeout(() => {
        heroBg.classList.add('loaded');
      }, 50);
    });
  }

  window.addEventListener('scroll', () => {
    const y = window.scrollY;
    const heroHeight = window.innerHeight;
    if (heroBg) {
      if (y <= heroHeight) {
        heroBg.style.transform = `scale(1) translateY(${y * 0.25}px)`;
      }
    }
    if (ctaBgImg) ctaBgImg.style.transform = `scale(1.05) translateY(${-y * 0.05}px)`;
  }, { passive: true });
</script>
