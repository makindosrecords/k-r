const getSrcSet = (src: string) => {
  const decoded = decodeURI(src);
  const ext = decoded.substring(decoded.lastIndexOf('.'));
  const base = decoded.substring(0, decoded.lastIndexOf('.'));
  const encoded400 = encodeURI(`${base}_400w${ext}`);
  const encoded720 = encodeURI(`${base}_720w${ext}`);
  const encoded1200 = encodeURI(`${base}_1200w${ext}`);
  const encodedOrig = encodeURI(decoded);
  return `${encoded400} 400w, ${encoded720} 720w, ${encoded1200} 1200w, ${encodedOrig} 1920w`;
};

