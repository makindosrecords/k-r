---
<Layout title="K&R Photography | Weddings, Portraits & Real Estate | Central FL">

  <!-- ─── HERO ─── -->
  <section class="hero">
    <div class="hero-bg" style="background-image:url('/weddings/k1%20(4)_result.webp');"></div>
    <div class="hero-vignette"></div>

    <!-- Ambient gold orb -->
    <div style="position:absolute;top:20%;right:15%;width:600px;height:600px;background:radial-gradient(circle,rgba(201,168,76,0.12) 0%,transparent 70%);border-radius:50%;animation:pulseGold 8s ease-in-out infinite;pointer-events:none;"></div>

    <div class="hero-content">
      <div class="hero-eyebrow">Kimberly & Rick • Central Florida • Est. 2004</div>

      <h1 class="hero-title">
        <span class="line"><span>The Art</span></span>
        <span class="line"><span>of <em>Light &</em></span></span>
        <span class="line"><span><em>Memory</em></span></span>
      </h1>

      <div class="hero-meta">
        <div class="hero-stat">
          <strong>20+</strong>
          Years of Craft
        </div>
        <div class="hero-divider"></div>
        <div class="hero-stat">
          <strong>380+</strong>
          5-Star Reviews
        </div>
        <div class="hero-divider"></div>
        <div class="hero-stat">
          <strong>Two</strong>
          Lead Artists Always
        </div>
        <div style="margin-left:auto;">
          <a href="/contact" class="cta-btn">Reserve Your Date</a>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div style="position:absolute;right:40px;bottom:60px;display:flex;flex-direction:column;align-items:center;gap:12px;opacity:0;animation:fadeSlideUp 1s var(--ease-out-expo) 1.4s forwards;">
      <span style="font-family:'Cinzel',serif;font-size:8px;letter-spacing:0.35em;text-transform:uppercase;color:rgba(201,168,76,0.6);writing-mode:vertical-rl;transform:rotate(180deg);">Scroll to explore</span>
      <div style="width:1px;height:48px;background:linear-gradient(to bottom,rgba(201,168,76,0.6),transparent);animation:pulseGold 2s ease-in-out infinite;"></div>
    </div>
  </section>

  <!-- ─── SERVICES BAND ─── -->
  <section style="background:var(--black-soft);padding:0 60px;border-top:1px solid rgba(184,150,53,0.18);border-bottom:1px solid rgba(184,150,53,0.18);">
    <div style="max-width:1200px;margin:0 auto;display:grid;grid-template-columns:repeat(3,1fr);gap:0;" class="services-grid">
      
      {[
        { num: '01', title: 'Weddings & Couples', desc: 'Full-day wedding coverage by two lead photographers. Editorial, candid, and timeless.', href: '/weddings-and-couples' },
        { num: '02', title: 'Family & Portraits', desc: 'Golden hour beach and lifestyle sessions across Orlando, Daytona & Cocoa Beach.', href: '/family-and-portraits' },
        { num: '03', title: 'B2B Real Estate', desc: 'Flambient HDR interior & exterior media for top-producing agents. 24hr delivery.', href: '/real-estate' },
      ].map((s, i) => (
        <a href={s.href} style={`display:block;padding:56px 40px;text-decoration:none;border-right:${i < 2 ? '1px solid rgba(184,150,53,0.15)' : 'none'};transition:background 0.4s ease;position:relative;overflow:hidden;`} class="service-link">
          <div style="font-family:'Cinzel',serif;font-size:13px;font-weight:700;letter-spacing:0.3em;color:#A3802C;margin-bottom:16px;text-transform:uppercase;">{s.num}</div>
          <h3 style="font-family:'Cormorant Garamond',serif;font-size:32px;font-weight:400;color:#11100F;margin-bottom:12px;transition:color 0.3s;">{s.title}</h3>
          <p style="font-size:15px;line-height:1.75;color:#3D3934;max-width:280px;font-weight:400;">{s.desc}</p>
          <div style="margin-top:28px;display:inline-flex;align-items:center;gap:10px;font-family:'Cinzel',serif;font-size:12px;font-weight:600;letter-spacing:0.22em;text-transform:uppercase;color:#A3802C;">
            View Work
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="transition:transform 0.3s;"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ─── CINEMATIC ARROW GALLERY ─── -->
  <section class="hscroll-section" id="gallery" style="padding:100px 0 80px;overflow:hidden;">
    <div style="padding:0 60px 50px;max-width:1200px;margin:0 auto;" class="reveal">
      <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:24px;flex-wrap:wrap;">
        <div>
          <span style="font-family:'Cinzel',serif;font-size:14px;font-weight:600;letter-spacing:0.25em;text-transform:uppercase;color:#A3802C;">
            <span class="gold-line"></span>Curated Archive
          </span>
          <h2 style="font-family:'Cormorant Garamond',serif;font-size:clamp(44px,5vw,72px);font-weight:300;color:#11100F;margin-top:12px;line-height:0.95;">
            Featured<br/><em style="font-style:italic;">Works</em>
          </h2>
        </div>
        <!-- Arrow navigation -->
        <div style="display:flex;align-items:center;gap:14px;flex-shrink:0;padding-bottom:6px;">
          <button id="gal-prev" aria-label="Previous photo" style="width:52px;height:52px;border-radius:50%;border:1px solid rgba(163,128,44,0.35);background:rgba(255,255,255,0.9);backdrop-filter:blur(12px);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all 0.3s ease;color:#11100F;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <span id="gal-counter" style="font-family:'Cinzel',serif;font-size:11px;letter-spacing:0.22em;color:#A3802C;font-weight:600;min-width:44px;text-align:center;">1 / {gallery.length}</span>
          <button id="gal-next" aria-label="Next photo" style="width:52px;height:52px;border-radius:50%;border:1px solid rgba(163,128,44,0.35);background:rgba(255,255,255,0.9);backdrop-filter:blur(12px);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all 0.3s ease;color:#11100F;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Track viewport -->
    <div class="h-gallery-wrap" style="padding:0 60px;">
      <div class="h-gallery-track" id="gallery-track">
        {gallery.map((item) => (
          <div 
            class="gallery-card"
            data-image={item.image}
            data-title={item.title}
            data-cat={item.category}
            data-loc={item.location}
            style={`width:${item.w}px; height:${item.h}px; flex-shrink:0; cursor:pointer;`}
          >
            <img
              src={item.image}
              alt={item.title}
              loading="lazy"
              draggable="false"
              width={item.w}
              height={item.h}
              style="width:100%; height:100%; object-fit:cover; display:block; pointer-events:none;"
            />
          </div>
        ))}
      </div>
    </div>

    <!-- Dot indicators -->
    <div id="gal-dots" style="display:flex;justify-content:center;gap:8px;margin-top:32px;padding:0 60px;"></div>
  </section>

  <!-- ─── ARTIST MANIFESTO / ABOUT ─── -->
  <section class="about-section" id="about">
    <div class="about-image-col">
      <div class="img-wipe" style="height:100%;width:100%;">
        <img 
          src="/kim and rick.webp" 
          alt="Kimberly & Rick — K&R Photography"
          style="width:100%;height:100%;object-fit:cover;object-position:center top;"
        />
      </div>
    </div>

    <div class="about-text-col">

      <div class="reveal-right">
        <span style="font-family:'Cinzel',serif;font-size:14px;font-weight:700;letter-spacing:0.28em;text-transform:uppercase;color:#A3802C;">
          <span class="gold-line"></span>Meet Kimberly &amp; Rick
        </span>
      </div>

      <h2 class="reveal-right" style="font-family:'Cormorant Garamond',serif;font-size:clamp(44px,4.5vw,68px);font-weight:300;color:#11100F;line-height:1.1;transition-delay:0.1s;">
        Capturing Love, Laughter &amp;<br/><em style="font-style:italic;background:linear-gradient(135deg,#B89635 0%,#8A6D30 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;">Everything In Between</em>
      </h2>

      <div class="stagger-children reveal-right" style="transition-delay:0.2s;display:flex;flex-direction:column;gap:18px;">
        <p style="font-size:17.5px;line-height:1.8;color:#2E2A25;font-weight:400;">
          Welcome to K&amp;R Photography, where we’re all about capturing the good stuff—like love, laughter, and maybe a few happy tears! We’re Kimberly and Rick, your favorite husband and wife photography duo specializing in weddings and portraits across Central Florida.
        </p>
        <p style="font-size:16.5px;line-height:1.8;color:#5C5650;font-weight:400;">
          As a team, we know how to keep things fun and relaxed so you can focus on what really matters—like not tripping down the aisle! With our unique blend of photojournalistic flair and fine art style, we promise to snap those candid moments and epic poses that truly reflect your personalities.
        </p>

        <!-- Kimberly's Personal Note -->
        <div style="background:rgba(255,255,255,0.7);border-left:2px solid #A3802C;padding:20px 24px;border-radius:0 6px 6px 0;margin-top:6px;box-shadow:0 6px 20px rgba(26,24,22,0.03);">
          <div style="font-family:'Cinzel',serif;font-size:11px;font-weight:700;letter-spacing:0.2em;text-transform:uppercase;color:#A3802C;margin-bottom:8px;">
            A Note From Kimberly
          </div>
          <p style="font-size:15px;line-height:1.75;color:#4A443E;font-style:italic;font-family:'Cormorant Garamond',serif;font-size:19px;margin:0;">
            “I stumbled upon my love for photography back in the darkroom days of middle school—yes, I was the kid who thought developing film was the coolest thing ever! With over 25 years of experience, I’ve captured everything from jaw-dropping weddings to family portraits. Just over 12 years ago, I met the love of my life, Rick, who encouraged me to chase my dreams. Little did he know I’d get him in on it too! Now we get to create magic together every single day.”
          </p>
        </div>
      </div>

      <!-- Studio Credentials -->
      <div class="reveal-right stagger-children" style="transition-delay:0.3s;display:grid;grid-template-columns:1fr 1fr;gap:24px;border-top:1px solid rgba(184,150,53,0.25);padding-top:30px;">
        {[
          { label: 'Years Behind The Lens', value: '25+' },
          { label: '5-Star Google Reviews', value: '380+' },
          { label: 'Weddings & Sessions', value: '1,200+' },
          { label: 'Lead Photographers', value: '2 Always' },
        ].map(c => (
          <div>
            <div style="font-family:'Cormorant Garamond',serif;font-size:42px;font-weight:400;color:#A3802C;line-height:1;">{c.value}</div>
            <div style="font-family:'Cinzel',serif;font-size:12px;font-weight:700;letter-spacing:0.2em;text-transform:uppercase;color:#3D3934;margin-top:6px;">{c.label}</div>
          </div>
        ))}
      </div>

      <div class="reveal-right" style="transition-delay:0.4s;display:flex;align-items:center;gap:18px;flex-wrap:wrap;">
        <a href="/contact" class="cta-btn" style="display:inline-flex;align-items:center;gap:10px;">
          Let’s Create Magic Together
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

    </div>
  </section>

  <!-- ─── TESTIMONIALS ─── -->
  <section style="background:var(--black);padding:140px 60px;position:relative;overflow:hidden;">
    <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:900px;height:500px;background:radial-gradient(circle,rgba(201,168,76,0.06) 0%,transparent 70%);border-radius:50%;pointer-events:none;"></div>
    
    <div style="max-width:1300px;margin:0 auto;position:relative;z-index:2;">
      
      <div class="reveal" style="text-align:center;margin-bottom:80px;">
        <span style="font-family:'Cinzel',serif;font-size:14px;font-weight:700;letter-spacing:0.28em;text-transform:uppercase;color:#A3802C;"><span class="gold-line"></span>Client Experiences</span>
        <h2 style="font-family:'Cormorant Garamond',serif;font-size:clamp(46px,5.5vw,76px);font-weight:300;color:#11100F;margin-top:12px;line-height:0.95;">Words From Our Families & Couples</h2>
        <p style="font-size:16px;color:#3D3934;margin-top:16px;font-weight:400;">Real stories from clients who trusted Kimberly & Rick with their milestone moments.</p>
      </div>

      <div class="stagger-children reveal testimonials-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:32px;">
        {testimonials.map(t => (
          <div class="testimonial-card" style="display:flex;flex-direction:column;justify-content:space-between;background:#FFFFFF;border:1px solid rgba(184,150,53,0.35);border-radius:20px;padding:44px 36px;box-shadow:0 18px 50px rgba(26,24,22,0.07);position:relative;">
            <div>
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
                <div style="color:#A3802C;font-size:16px;letter-spacing:0.18em;">★★★★★</div>
                <span style="font-family:'Cinzel',serif;font-size:10px;font-weight:700;letter-spacing:0.2em;text-transform:uppercase;color:#A3802C;background:rgba(201,168,76,0.12);padding:4px 10px;border-radius:20px;">{t.badge}</span>
              </div>
              <p style="font-family:'Cormorant Garamond',serif;font-size:19px;font-weight:400;line-height:1.75;color:#11100F;margin-bottom:32px;">"{t.text}"</p>
            </div>
            <div style="border-top:1px solid rgba(184,150,53,0.22);padding-top:20px;display:flex;justify-content:space-between;align-items:flex-end;">
              <div>
                <div style="font-family:'Cormorant Garamond',serif;font-size:24px;color:#11100F;font-weight:600;letter-spacing:0.02em;">{t.author}</div>
                <div style="font-family:'Cinzel',serif;font-size:11px;font-weight:700;letter-spacing:0.2em;text-transform:uppercase;color:#A3802C;margin-top:4px;">{t.role}</div>
              </div>
              <span style="font-size:12px;color:#7A7267;font-family:'Cinzel',serif;letter-spacing:0.1em;font-weight:600;">{t.location}</span>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ─── FULL-BLEED CTA SECTION ─── -->
  <section style="position:relative;height:70vh;display:flex;align-items:center;justify-content:center;overflow:hidden;border-top:1px solid rgba(184,150,53,0.2);">
    <div style="position:absolute;inset:0;background-image:url('/weddings/KIM_2618_result.webp');background-size:cover;background-position:center;opacity:0.25;transform:scale(1.05);" class="cta-bg-img"></div>
    <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(250,248,245,0.96) 0%,rgba(250,248,245,0.85) 100%);"></div>

    <div style="position:relative;z-index:2;text-align:center;max-width:760px;padding:40px;" class="reveal">
      <span style="font-family:'Cinzel',serif;font-size:16px;font-weight:700;letter-spacing:0.28em;text-transform:uppercase;color:#A3802C;display:block;margin-bottom:24px;">Your Story Deserves a Master</span>
      <h2 style="font-family:'Cormorant Garamond',serif;font-size:clamp(48px,6vw,84px);font-weight:300;color:#11100F;line-height:1;margin-bottom:36px;">Let’s Capture Your Story</h2>
      <p style="font-size:17px;color:#3D3934;line-height:1.8;margin-bottom:40px;max-width:520px;margin-left:auto;margin-right:auto;font-weight:400;">Ready to create something timeless? Kimberly & Rick personally respond to every inquiry within 24 hours.</p>
      <a href="/contact" class="cta-btn" style="font-size:13.5px;padding:16px 36px;">Book Kimberly & Rick</a>
    </div>
  </section>

</Layout>

<style>
  @media (max-width: 900px) {
    .services-grid { grid-template-columns: 1fr !important; }
    .service-link { border-right: none !important; border-bottom: 1px solid rgba(201,168,76,0.12); }
    .testimonials-grid { grid-template-columns: 1fr !important; }
  }
  .service-link:hover { background: rgba(201,168,76,0.04); }
  .service-link:hover h3 { color: var(--gold) !important; }

  .gallery-card {
    position: relative;
    cursor: pointer;
    background: transparent;
    border: none;
    box-shadow: none;
    border-radius: 0;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .gallery-card:hover {
    transform: scale(1.02);
    box-shadow: none;
  }

</style>

<script>
  // ─── CINEMATIC ARROW GALLERY ───
  const track = document.getElementById('gallery-track') as HTMLElement;
  const wrap = document.querySelector('.h-gallery-wrap') as HTMLElement;
  const btnPrev = document.getElementById('gal-prev') as HTMLButtonElement;
  const btnNext = document.getElementById('gal-next') as HTMLButtonElement;
  const counter = document.getElementById('gal-counter') as HTMLElement;
  const dotsEl = document.getElementById('gal-dots') as HTMLElement;

  if (track && wrap) {
    const cards = Array.from(track.querySelectorAll('.gallery-card')) as HTMLElement[];
    const total = cards.length;
    let currentCard = 0;
    let targetScroll = 0;
    let rafId = 0;

    // Build dot indicators
    cards.forEach((_, i) => {
      const dot = document.createElement('button');
      dot.style.cssText = 'width:6px;height:6px;border-radius:50%;border:none;cursor:pointer;transition:all 0.35s ease;padding:0;background:rgba(163,128,44,0.3);';
      dot.setAttribute('aria-label', `Photo ${i + 1}`);
      dot.addEventListener('click', () => goTo(i));
      dotsEl.appendChild(dot);
    });

    function updateUI() {
      counter.textContent = `${currentCard + 1} / ${total}`;
      if (btnPrev) {
        btnPrev.style.opacity = currentCard === 0 ? '0.35' : '1';
        btnPrev.style.pointerEvents = currentCard === 0 ? 'none' : 'auto';
      }
      if (btnNext) {
        btnNext.style.opacity = currentCard === total - 1 ? '0.35' : '1';
        btnNext.style.pointerEvents = currentCard === total - 1 ? 'none' : 'auto';
      }
      dotsEl.querySelectorAll('button').forEach((d, i) => {
        const isActive = i === currentCard;
        (d as HTMLElement).style.width = isActive ? '24px' : '6px';
        (d as HTMLElement).style.borderRadius = isActive ? '4px' : '50%';
        (d as HTMLElement).style.background = isActive ? '#A3802C' : 'rgba(163,128,44,0.3)';
      });
    }

    function lerp(current: number, target: number, factor: number) {
      return current + (target - current) * factor;
    }

    function easeOutCubic(t: number): number {
      return 1 - Math.pow(1 - t, 3);
    }

    let startScroll = 0;
    let animStartTime = 0;
    const ANIM_DURATION = 550; // ms for silky ease

    function smoothScroll(timestamp: number) {
      if (!animStartTime) animStartTime = timestamp;
      const elapsed = timestamp - animStartTime;
      const progress = Math.min(1, elapsed / ANIM_DURATION);
      const ease = easeOutCubic(progress);

      wrap.scrollLeft = startScroll + (targetScroll - startScroll) * ease;

      if (progress < 1) {
        rafId = requestAnimationFrame(smoothScroll);
      } else {
        wrap.scrollLeft = targetScroll;
      }
    }

    function goTo(idx: number) {
      currentCard = Math.max(0, Math.min(total - 1, idx));
      const card = cards[currentCard];
      const wrapWidth = wrap.clientWidth;
      const cardLeft = card.offsetLeft;
      const cardWidth = card.offsetWidth;
      targetScroll = cardLeft - (wrapWidth - cardWidth) / 2;
      targetScroll = Math.max(0, Math.min(wrap.scrollWidth - wrap.clientWidth, targetScroll));
      
      startScroll = wrap.scrollLeft;
      animStartTime = 0;
      cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(smoothScroll);
      updateUI();
    }

    btnPrev?.addEventListener('click', () => goTo(currentCard - 1));
    btnNext?.addEventListener('click', () => goTo(currentCard + 1));

    // Keyboard left/right arrow navigation on gallery (when not in lightbox)
    window.addEventListener('keydown', (e) => {
      if (document.getElementById('kr-lightbox')?.classList.contains('lb-open')) return;
      if (e.key === 'ArrowLeft') goTo(currentCard - 1);
      if (e.key === 'ArrowRight') goTo(currentCard + 1);
    });

    // Mouse wheel on gallery scroll with cooldown for distinct card glide
    let wheelCooldown = false;
    wrap.addEventListener('wheel', (e) => {
      e.preventDefault();
      if (wheelCooldown) return;
      if (Math.abs(e.deltaY) > 15 || Math.abs(e.deltaX) > 15) {
        wheelCooldown = true;
        const dir = (e.deltaY > 0 || e.deltaX > 0) ? 1 : -1;
        goTo(currentCard + dir);
        setTimeout(() => { wheelCooldown = false; }, 320);
      }
    }, { passive: false });

    // Touch swipe
    let swipeStartX = 0;
    wrap.addEventListener('touchstart', (e) => { swipeStartX = e.touches[0].clientX; }, { passive: true });
    wrap.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - swipeStartX;
      if (Math.abs(dx) > 40) goTo(currentCard + (dx < 0 ? 1 : -1));
    });

    // Hover effects on buttons
    [btnPrev, btnNext].forEach(btn => {
      if (!btn) return;
      btn.addEventListener('mouseenter', () => {
        btn.style.background = '#11100F';
        btn.style.color = '#FAF8F5';
        btn.style.borderColor = '#11100F';
      });
      btn.addEventListener('mouseleave', () => {
        btn.style.background = 'rgba(255,255,255,0.9)';
        btn.style.color = '#11100F';
        btn.style.borderColor = 'rgba(163,128,44,0.35)';
      });
    });

    // Init
    goTo(0);

    // ── LIGHTBOX ──
    const galleryArr = cards.map((c, i) => ({
      index: i,
      image: c.getAttribute('data-image') || '',
      title: c.getAttribute('data-title') || '',
      cat: c.getAttribute('data-cat') || '',
      loc: c.getAttribute('data-loc') || '',
    }));

    let lb = document.getElementById('kr-lightbox');
    if (!lb) {
      lb = document.createElement('div');
      lb.id = 'kr-lightbox';
      lb.innerHTML = `
        <div class="lb-header">
          <div style="display:flex;align-items:center;gap:12px;">
            <span style="font-family:'Cinzel',serif;font-size:11px;letter-spacing:0.25em;color:#A3802C;font-weight:600;">K&amp;R PHOTOGRAPHY</span>
            <span style="width:1px;height:14px;background:rgba(163,128,44,0.3);"></span>
            <span id="lb-counter" style="font-family:'Cinzel',serif;font-size:11px;letter-spacing:0.18em;color:#3D3934;font-weight:600;"></span>
          </div>
          <button class="lb-close-btn lb-btn" id="lb-close" aria-label="Close">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
          </button>
        </div>
        <div class="lb-stage" id="lb-stage">
          <button class="lb-nav-btn prev lb-btn" id="lb-prev" aria-label="Previous">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <div class="lb-img-wrap" id="lb-img-wrap" style="display:flex;align-items:center;justify-content:center;width:100%;height:100%;pointer-events:none;">
            <img id="lb-stage-img" class="lb-stage-img" src="" alt="" style="pointer-events:all;" />
          </div>
          <button class="lb-nav-btn next lb-btn" id="lb-next" aria-label="Next">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
        <div class="lb-footer">
          <div class="lb-info-row" style="display:flex;justify-content:space-between;align-items:center;width:100%;">
            <div>
              <div id="lb-title" style="font-family:'Cormorant Garamond',serif;font-size:24px;font-weight:400;color:#11100F;"></div>
              <div id="lb-meta" style="font-family:'Cinzel',serif;font-size:10px;letter-spacing:0.2em;text-transform:uppercase;color:#A3802C;margin-top:4px;"></div>
            </div>
            <div style="font-family:'Cinzel',serif;font-size:9.5px;letter-spacing:0.16em;color:#5C5650;text-align:right;" class="hide-mobile">
              ← → Navigate &nbsp;·&nbsp; Esc Close
            </div>
          </div>
        </div>
      `;
      document.body.appendChild(lb);
    }

    const lbStageImg = lb.querySelector('#lb-stage-img') as HTMLImageElement;
    const lbTitle = lb.querySelector('#lb-title') as HTMLElement;
    const lbMeta = lb.querySelector('#lb-meta') as HTMLElement;
    const lbCounter = lb.querySelector('#lb-counter') as HTMLElement;

    let lbIdx = 0;

    function showImage(idx: number) {
      lbIdx = ((idx % total) + total) % total;
      const item = galleryArr[lbIdx];
      if (!item) return;

      if (lbStageImg) {
        lbStageImg.src = item.image;
        lbStageImg.alt = item.title;
      }
      if (lbTitle) lbTitle.textContent = item.title;
      if (lbMeta) lbMeta.textContent = `${item.cat} · ${item.loc}`;
      if (lbCounter) lbCounter.textContent = `${lbIdx + 1} / ${total}`;
    }

    function openLb(idx: number) {
      showImage(idx);
      lb!.classList.add('lb-open');
      document.body.style.overflow = 'hidden';
    }

    function closeLb() {
      lb!.classList.remove('lb-open');
      document.body.style.overflow = '';
    }

    cards.forEach((card, i) => {
      card.addEventListener('click', (e) => {
        e.preventDefault();
        openLb(i);
      });
    });

    lb.querySelector('#lb-close')?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeLb();
    });
    lb.querySelector('#lb-prev')?.addEventListener('click', (e) => {
      e.stopPropagation();
      showImage(lbIdx - 1);
    });
    lb.querySelector('#lb-next')?.addEventListener('click', (e) => {
      e.stopPropagation();
      showImage(lbIdx + 1);
    });

    lb.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.id === 'lb-stage' || target.id === 'kr-lightbox' || target.id === 'lb-img-wrap' || target.closest('#lb-close')) {
        closeLb();
      }
    });

    window.addEventListener('keydown', (e) => {
      if (!lb!.classList.contains('lb-open')) return;
      if (e.key === 'ArrowLeft') showImage(lbIdx - 1);
      if (e.key === 'ArrowRight') showImage(lbIdx + 1);
      if (e.key === 'Escape') closeLb();
    });

    let lbSwipeX = 0;
    lb.addEventListener('touchstart', (e) => { lbSwipeX = e.touches[0].clientX; }, { passive: true });
    lb.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - lbSwipeX;
      if (Math.abs(dx) > 40) showImage(lbIdx + (dx < 0 ? 1 : -1));
    });
  }

  // ─── PARALLAX HERO ───
  const heroBg = document.querySelector('.hero-bg') as HTMLElement;
  const ctaBgImg = document.querySelector('.cta-bg-img') as HTMLElement;
  window.addEventListener('scroll', () => {
    const y = window.scrollY;
    if (heroBg) heroBg.style.transform = `scale(1) translateY(${y * 0.25}px)`;
    if (ctaBgImg) ctaBgImg.style.transform = `scale(1.05) translateY(${-y * 0.05}px)`;
  }, { passive: true });
</script>
