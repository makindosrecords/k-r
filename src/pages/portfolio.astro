---
import Layout from '../layouts/Layout.astro';

const allPortfolioItems = [
  // Interleaved Editorial Layout (6 Headshots evenly spaced, 0 adjacent)
  { id: 'w1', num: '01', title: 'Estate Lawn Couple Portrait', category: 'Weddings & Couples', location: 'Central Florida', image: '/weddings/KIM_6894_result.webp',   format: 'tall' as const },
  { id: 'f1', num: '02', title: 'Coastal Dunes Family Portrait', category: 'Family & Lifestyle', location: 'Central Florida', image: '/family/KIM_8902_result.webp',     format: 'tall' as const },
  { id: 'r1', num: '03', title: 'Waterfront Estate',           category: 'Real Estate Media', location: 'Central Florida', image: '/real%20estate/AEC_4701_result.webp', format: 'wide' as const },
  { id: 'h1', num: '04', title: 'Executive Studio Portrait',   category: 'Executive Series',  location: 'Central Florida', image: '/headshots/KIM_0296_result.webp', format: 'tall' as const },

  { id: 'w2', num: '05', title: 'Bella Collina Dip & Kiss',    category: 'Weddings & Couples', location: 'Central Florida', image: '/weddings/DSC_0045-2_result.webp', format: 'wide' as const },
  { id: 'f2', num: '06', title: 'Multi-Generational Live Oak', category: 'Family & Lifestyle', location: 'Central Florida', image: '/family/KIM_0075_result.webp',     format: 'wide' as const },
  { id: 'r2', num: '07', title: 'Living Room Interior',        category: 'Real Estate Media', location: 'Central Florida', image: '/real%20estate/AEC_4860_result.webp', format: 'wide' as const },
  { id: 'w3', num: '08', title: 'Coastal Sage Bridal Party',   category: 'Weddings & Couples', location: 'Central Florida', image: '/weddings/KIM_2100_result.webp',   format: 'wide' as const },
  { id: 'f3', num: '09', title: 'Arbor Walkway Family',        category: 'Family & Lifestyle', location: 'Central Florida', image: '/family/KIM_6504_result.webp',     format: 'tall' as const },
  { id: 'h4', num: '10', title: 'Corporate Leadership Portrait', category: 'Executive Series', location: 'Central Florida', image: '/headshots/KIM_0251_result.webp', format: 'tall' as const },

  { id: 'r3', num: '11', title: 'Twilight Exterior',          category: 'Real Estate Media', location: 'Central Florida', image: '/real%20estate/AEC_4705_result.webp', format: 'wide' as const },
  { id: 'w4', num: '12', title: 'Bridal Elegance',             category: 'Weddings & Couples', location: 'Central Florida', image: '/weddings/KIM_5353_result.webp',   format: 'tall' as const },
  { id: 'f4', num: '13', title: 'Pastel Shoreline Family Walk', category: 'Family & Lifestyle', location: 'Central Florida', image: '/family/KIM_7250-2_result.webp',   format: 'wide' as const },
  { id: 'r4', num: '14', title: 'Architectural Foyer',        category: 'Real Estate Media', location: 'Central Florida', image: '/real%20estate/AEC_4584_result.webp', format: 'tall' as const },
  { id: 'w5', num: '15', title: 'Bride & Groom Intimate',      category: 'Weddings & Couples', location: 'Central Florida', image: '/weddings/1_5_result.webp',    format: 'tall' as const },
  { id: 'h2', num: '16', title: 'Studio Headshot Series',      category: 'Executive Series',  location: 'Central Florida', image: '/headshots/KIM_8226_result.webp', format: 'tall' as const },

  { id: 'f5', num: '17', title: 'Lush Garden Family Joy',      category: 'Family & Lifestyle', location: 'Central Florida', image: '/family/KIM_8221_result.webp',     format: 'tall' as const },
  { id: 'r5', num: '18', title: 'Luxury Living & Dining',     category: 'Real Estate Media', location: 'Central Florida', image: '/real%20estate/AEC_4633_result.webp', format: 'wide' as const },
  { id: 'w6', num: '19', title: 'Fun Wedding Party & Grinch',  category: 'Weddings & Couples', location: 'Central Florida', image: '/weddings/KIM_8018_result.webp',   format: 'wide' as const },
  { id: 'f6', num: '20', title: 'Sand Dunes Family Session',   category: 'Family & Lifestyle', location: 'Central Florida', image: '/family/KIM_3497_result.webp',     format: 'wide' as const },
  { id: 'r6', num: '21', title: 'Gourmet Kitchen Detail',     category: 'Real Estate Media', location: 'Central Florida', image: '/real%20estate/AEC_4637_result.webp', format: 'tall' as const },
  { id: 'h5', num: '22', title: 'Commercial Studio Series',     category: 'Executive Series', location: 'Central Florida', image: '/headshots/KIM_0410_result.webp', format: 'tall' as const },

  { id: 'w7', num: '23', title: 'Bridal Suite Romance',        category: 'Weddings & Couples', location: 'Central Florida', image: '/KIM_9003-2.webp',                  format: 'tall' as const },
  { id: 'f7', num: '24', title: 'Beach Running Family Motion', category: 'Family & Lifestyle', location: 'Central Florida', image: '/family/KIM_7258_result.webp',     format: 'tall' as const },
  { id: 'r7', num: '25', title: 'Open Concept Interior',     category: 'Real Estate Media', location: 'Central Florida', image: '/real%20estate/AEC_4638_result.webp', format: 'wide' as const },
  { id: 'w8', num: '26', title: 'Sunset Couple Embrace',       category: 'Weddings & Couples', location: 'Central Florida', image: '/weddings/KIM_6682-2_result.webp', format: 'wide' as const },
  { id: 'f8', num: '27', title: 'Sand Dune Family Smile',      category: 'Family & Lifestyle', location: 'Central Florida', image: '/family/KIM_7349_result.webp',     format: 'tall' as const },
  { id: 'h3', num: '28', title: 'Executive Branding',          category: 'Executive Series',  location: 'Central Florida', image: '/headshots/KIM_8852_result.webp', format: 'tall' as const },

  { id: 'w9', num: '29', title: 'Heart Veil Monochromatic',    category: 'Weddings & Couples', location: 'Central Florida', image: '/weddings/DSC_0773-2_result.webp', format: 'tall' as const },
  { id: 'f9', num: '30', title: 'Estate Portrait Ensemble',    category: 'Family & Lifestyle', location: 'Central Florida', image: '/family/KIM_8822_result.webp',     format: 'wide' as const },
  { id: 'w10', num: '31', title: 'Groomsmen Beach Tug-of-War', category: 'Weddings & Couples', location: 'Central Florida', image: '/weddings/RIC_4988-2_result.webp', format: 'tall' as const },
  { id: 'f10', num: '32', title: 'Three Brothers Beach Hug',   category: 'Family & Lifestyle', location: 'Central Florida', image: '/family/KIM_8930_result.webp',     format: 'wide' as const },
  { id: 'h6', num: '33', title: 'Executive Presence Portrait',  category: 'Executive Series', location: 'Central Florida', image: '/headshots/KIM_0620_result.webp', format: 'tall' as const },
  { id: 'w11', num: '34', title: 'Shades & Bouquet Porch Shot', category: 'Weddings & Couples', location: 'Central Florida', image: '/weddings/DSC_0752-2_result.webp', format: 'wide' as const },
  { id: 'w12', num: '35', title: 'Golden Hour Beach Embrace',  category: 'Weddings & Couples', location: 'Central Florida', image: '/weddings/KIM_2729-3_result.webp', format: 'wide' as const },
];

const categoryCounts: Record<string, number> = {
  'All Works': allPortfolioItems.length,
  'Weddings & Couples': allPortfolioItems.filter(i => i.category === 'Weddings & Couples').length,
  'Family & Lifestyle': allPortfolioItems.filter(i => i.category === 'Family & Lifestyle').length,
  'Real Estate Media': allPortfolioItems.filter(i => i.category === 'Real Estate Media').length,
  'Executive Series': allPortfolioItems.filter(i => i.category === 'Executive Series').length,
};

const categories = ['All Works', 'Weddings & Couples', 'Family & Lifestyle', 'Real Estate Media', 'Executive Series'];
---

<Layout
  title="Complete Portfolio Archive | K&R Photography"
  description="Explore the fine art photography archive of Kimberly & Rick. Weddings, couples, families, real estate, and executive headshots across Central Florida."
>

  <!-- ─── HERO ─── -->
  <section class="hero">
    <div class="hero-bg" style="background-image:url('/weddings/1_5_result.webp');"></div>
    <div class="hero-vignette"></div>
    <div class="hero-content">
      <div class="hero-eyebrow">Fine Art Archive · Kimberly &amp; Rick · Est. 2004</div>
      <h1 class="hero-title">
        <span class="line"><span>The Complete</span></span>
        <span class="line"><span>Studio <em>Archive</em></span></span>
      </h1>
      <div class="hero-meta">
        <div class="hero-stat"><strong>20+</strong>Years Craft</div>
        <div class="hero-divider"></div>
        <div class="hero-stat"><strong>380+</strong>5-Star Reviews</div>
        <div style="margin-left:auto;"><a href="/contact" class="cta-btn">Reserve Your Date</a></div>
      </div>
    </div>
  </section>

  <!-- ─── MUSEUM EXHIBITION GALLERY ─── -->
  <section style="background:var(--black);padding:100px 60px 140px;">
    <div style="max-width:1440px;margin:0 auto;">

      <!-- Curated Header & Collection Navigation -->
      <div style="text-align:center;margin-bottom:70px;">
        <span style="font-family:'Cinzel',serif;font-size:14px;font-weight:700;letter-spacing:0.28em;text-transform:uppercase;color:#A3802C;">
          <span class="gold-line"></span>Selected Works · 2004–2026
        </span>
        <h2 style="font-family:'Cormorant Garamond',serif;font-size:clamp(46px,5.5vw,76px);font-weight:300;color:#11100F;margin-top:14px;margin-bottom:40px;line-height:0.95;">
          The Curated Collection
        </h2>

        <!-- Minimalist Editorial Filter Tabs -->
        <div class="collection-filter-nav" id="portfolio-filters">
          {categories.map((cat, i) => (
            <button
              type="button"
              class={`col-tab-btn ${i === 0 ? 'active' : ''}`}
              data-category={cat}
            >
              <span class="col-tab-name">{cat}</span>
              <span class="col-tab-count">({categoryCounts[cat]})</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Fine Art Masonry Gallery -->
      <div class="exhibition-grid" id="portfolio-grid">
        {allPortfolioItems.map((item, idx) => (
          <article
            class="art-plate-card"
            data-category={item.category}
            data-index={idx}
            data-image={item.image}
            data-title={item.title}
            data-cat={item.category}
            data-loc={item.location}
          >
            <img
              src={item.image}
              alt={item.title}
              decoding="async"
              class="art-img"
            />
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- ─── DEDICATED GALLERIES PORTAL ─── -->
  <section style="background:var(--black-soft);padding:110px 60px;border-top:1px solid rgba(184,150,53,0.18);">
    <div style="max-width:1300px;margin:0 auto;">
      <div class="reveal" style="text-align:center;margin-bottom:60px;">
        <span style="font-family:'Cinzel',serif;font-size:14px;font-weight:700;letter-spacing:0.28em;text-transform:uppercase;color:#A3802C;">
          <span class="gold-line"></span>Specialized Portfolios
        </span>
        <h2 style="font-family:'Cormorant Garamond',serif;font-size:48px;font-weight:300;color:#11100F;margin-top:12px;">
          Dedicated Editorial Experiences
        </h2>
        <p style="font-size:15px;color:#5C5650;max-width:560px;margin:12px auto 0;font-family:'Inter',sans-serif;">
          Experience our interactive scroll-locked visual essays created for weddings, coastal families, and luxury real estate.
        </p>
      </div>

      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:28px;" class="services-grid">
        {[
          { title: 'Weddings & Couples', desc: 'Full-day wedding & engagement coverage by Kimberly & Rick.', href: '/weddings-and-couples', img: '/weddings/DSC_0045-2_result.webp' },
          { title: 'Family & Portraits', desc: 'Golden hour beach & fine art lifestyle sessions across Central Florida.', href: '/family-and-portraits', img: '/family/KIM_7294_result.webp' },
          { title: 'B2B Real Estate Media', desc: 'Flambient interior & architectural imagery with 24-hour turnaround.', href: '/real-estate', img: '/real%20estate/AEC_4956_result.webp' },
        ].map(cat => (
          <a href={cat.href} class="editorial-portal-card">
            <div class="editorial-portal-frame">
              <img src={cat.img} alt={cat.title} decoding="async" class="editorial-portal-img" />
            </div>
            <div class="editorial-portal-info">
              <span class="editorial-portal-eyebrow">Scroll-Locked Essay</span>
              <h3 class="editorial-portal-title">{cat.title}</h3>
              <p class="editorial-portal-desc">{cat.desc}</p>
              <div class="editorial-portal-link">
                <span>Enter Gallery</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ─── Minimalist Editorial Filter Tabs ─── */
  .collection-filter-nav {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.85);
    padding: 6px;
    border-radius: 100px;
    border: 1px solid rgba(184, 150, 53, 0.25);
    box-shadow: 0 8px 30px rgba(26, 24, 22, 0.04);
  }

  .col-tab-btn {
    background: transparent;
    border: none;
    color: #3D3934;
    font-family: 'Cinzel', serif;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 10px 22px;
    border-radius: 100px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .col-tab-count {
    font-size: 10px;
    color: #A3802C;
    letter-spacing: 0;
  }

  .col-tab-btn:hover {
    color: #11100F;
    background: rgba(184, 150, 53, 0.08);
  }

  .col-tab-btn.active {
    background: #11100F;
    color: #FAF8F5;
    box-shadow: 0 4px 16px rgba(17, 16, 15, 0.18);
  }

  .col-tab-btn.active .col-tab-count {
    color: #C9A84C;
  }

  /* ─── Fine Art Masonry Gallery ─── */
  .exhibition-grid {
    column-count: 3;
    column-gap: 10px;
  }

  .art-plate-card {
    break-inside: avoid;
    display: block;
    margin-bottom: 10px;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(184, 150, 53, 0.15);
  }

  .art-img {
    width: 100%;
    height: auto;
    display: block;
    transform: translateZ(0);
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
  }

  .art-plate-card:hover .art-img {
    transform: scale(1.03);
  }

  @media (max-width: 1000px) {
    .exhibition-grid { column-count: 2; }
  }

  @media (max-width: 580px) {
    .exhibition-grid { column-count: 1; }
  }

  /* ─── Architectural Fine Art Caption ─── */
  .art-caption {
    padding-top: 18px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    transition: transform 0.4s ease;
  }

  .art-caption-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .art-index {
    font-family: 'Cinzel', serif;
    font-size: 11px;
    letter-spacing: 0.2em;
    color: #A3802C;
    font-weight: 600;
  }

  .art-collection {
    font-family: 'Cinzel', serif;
    font-size: 9.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #7A7267;
    font-weight: 600;
  }

  .art-heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: 25px;
    font-weight: 400;
    color: #11100F;
    margin: 3px 0 6px;
    line-height: 1.15;
    transition: color 0.3s ease;
  }

  .art-plate-card:hover .art-heading {
    color: #A3802C;
  }

  .art-caption-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 6px;
    border-top: 1px solid rgba(184, 150, 53, 0.12);
  }

  .art-locale {
    font-family: 'Cinzel', serif;
    font-size: 9px;
    letter-spacing: 0.2em;
    color: #8C8479;
    text-transform: uppercase;
  }

  .art-action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'Cinzel', serif;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #11100F;
    transition: color 0.3s ease, transform 0.3s ease;
  }

  .art-action svg {
    transition: transform 0.3s ease;
  }

  .art-plate-card:hover .art-action {
    color: #A3802C;
  }

  .art-plate-card:hover .art-action svg {
    transform: translateX(3px);
  }

  /* ─── Clean Editorial Portal Cards ─── */
  .editorial-portal-card {
    display: flex;
    flex-direction: column;
    background: #FAF8F5;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(184, 150, 53, 0.22);
    box-shadow: 0 10px 30px rgba(26, 24, 22, 0.04);
    text-decoration: none;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.5s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s ease;
  }

  .editorial-portal-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 45px rgba(26, 24, 22, 0.1);
    border-color: rgba(184, 150, 53, 0.5);
  }

  .editorial-portal-frame {
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #F3EFEA;
  }

  .editorial-portal-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .editorial-portal-card:hover .editorial-portal-img {
    transform: scale(1.05);
  }

  .editorial-portal-info {
    padding: 24px 28px 28px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .editorial-portal-eyebrow {
    font-family: 'Cinzel', serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #A3802C;
    margin-bottom: 6px;
  }

  .editorial-portal-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 26px;
    font-weight: 400;
    color: #11100F;
    margin: 0 0 8px;
    line-height: 1.15;
  }

  .editorial-portal-desc {
    font-size: 13.5px;
    color: #5C5650;
    line-height: 1.5;
    margin: 0 0 20px;
    font-family: 'Inter', sans-serif;
    flex: 1;
  }

  .editorial-portal-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'Cinzel', serif;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #11100F;
    transition: color 0.3s ease;
  }

  .editorial-portal-link svg {
    transition: transform 0.3s ease;
  }

  .editorial-portal-card:hover .editorial-portal-link {
    color: #A3802C;
  }

  .editorial-portal-card:hover .editorial-portal-link svg {
    transform: translateX(4px);
  }

  @media (max-width: 1024px) {
    .exhibition-grid { grid-template-columns: repeat(2, 1fr); gap: 32px; }
    .services-grid { grid-template-columns: 1fr !important; gap: 20px !important; }
  }

  @media (max-width: 640px) {
    .exhibition-grid { grid-template-columns: 1fr; gap: 40px; }
  }
</style>

<script>
  const cards = document.querySelectorAll('.art-plate-card');
  const galleryArr = Array.from(cards).map(c => ({
    image: c.getAttribute('data-image') || '',
    title: c.getAttribute('data-title') || '',
    cat: c.getAttribute('data-cat') || '',
    loc: c.getAttribute('data-loc') || '',
    el: c as HTMLElement
  }));

  // ─── FILTER TABS ───
  const filterBtns = document.querySelectorAll('.col-tab-btn');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const selectedCat = btn.getAttribute('data-category');

      cards.forEach(card => {
        const cardCat = card.getAttribute('data-category');
        const shouldShow = selectedCat === 'All Works' || cardCat === selectedCat;

        if (shouldShow) {
          (card as HTMLElement).style.display = 'flex';
          (card as HTMLElement).style.opacity = '1';
          (card as HTMLElement).style.transform = 'translateY(0)';
        } else {
          (card as HTMLElement).style.opacity = '0';
          (card as HTMLElement).style.transform = 'translateY(8px)';
          setTimeout(() => {
            if ((card as HTMLElement).style.opacity === '0') {
              (card as HTMLElement).style.display = 'none';
            }
          }, 250);
        }
      });
    });
  });

  // ─── INSTANT CINEMATIC LIGHTBOX ───
  let lb = document.getElementById('kr-lightbox');
  if (!lb) {
    lb = document.createElement('div');
    lb.id = 'kr-lightbox';
    lb.innerHTML = `
      <div class="lb-header">
        <div style="display:flex;align-items:center;gap:12px;">
          <span style="font-family:'Cinzel',serif;font-size:11px;letter-spacing:0.25em;color:#A3802C;font-weight:500;">K&amp;R PHOTOGRAPHY</span>
          <span style="width:1px;height:14px;background:rgba(163,128,44,0.3);"></span>
          <span id="lb-counter" style="font-family:'Cinzel',serif;font-size:11px;letter-spacing:0.18em;color:#3D3934;"></span>
        </div>
        <button class="lb-close-btn lb-btn" id="lb-close" aria-label="Close">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
      </div>

      <div class="lb-stage" id="lb-stage">
        <button class="lb-nav-btn prev lb-btn" id="lb-prev" aria-label="Previous">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <div class="lb-img-wrap" id="lb-img-wrap" style="position:relative;width:100%;height:100%;display:flex;align-items:center;justify-content:center;">
          <img id="lb-stage-img" class="lb-stage-img" src="" alt="" />
        </div>
        <button class="lb-nav-btn next lb-btn" id="lb-next" aria-label="Next">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>

      <div class="lb-footer">
        <div class="lb-info-row" style="display:flex;justify-content:space-between;align-items:center;width:100%;">
          <div>
            <div id="lb-title" style="font-family:'Cormorant Garamond',serif;font-size:24px;font-weight:400;color:#11100F;"></div>
            <div id="lb-meta" style="font-family:'Cinzel',serif;font-size:10px;letter-spacing:0.2em;text-transform:uppercase;color:#A3802C;margin-top:4px;"></div>
          </div>
          <div style="font-family:'Cinzel',serif;font-size:9px;letter-spacing:0.16em;color:#3D3934;text-align:right;" class="hide-mobile">
            ← → Navigate &nbsp;·&nbsp; Esc Close
          </div>
        </div>
      </div>
    `;
    document.body.appendChild(lb);
  }

  const lbStageImg = lb.querySelector('#lb-stage-img') as HTMLImageElement;
  const lbTitle = lb.querySelector('#lb-title') as HTMLElement;
  const lbMeta = lb.querySelector('#lb-meta') as HTMLElement;
  const lbCounter = lb.querySelector('#lb-counter') as HTMLElement;

  let currentIdx = -1;

  function getVisibleItems() {
    return galleryArr.filter(item => item.el.style.display !== 'none');
  }

  function showImage(targetIdx: number) {
    const visible = getVisibleItems();
    if (!visible.length) return;
    currentIdx = ((targetIdx % visible.length) + visible.length) % visible.length;
    const item = visible[currentIdx];

    lbStageImg.src = item.image;
    lbStageImg.alt = item.title;
    lbTitle.textContent = item.title;
    lbMeta.textContent = `${item.cat} · ${item.loc}`;
    lbCounter.textContent = `${currentIdx + 1} / ${visible.length}`;
  }

  function openLightbox(item: any) {
    const visible = getVisibleItems();
    const idx = visible.indexOf(item);
    showImage(idx >= 0 ? idx : 0);
    lb!.classList.add('lb-open');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    lb!.classList.remove('lb-open');
    document.body.style.overflow = '';
  }

  galleryArr.forEach(item => {
    item.el.addEventListener('click', () => openLightbox(item));
  });

  lb.querySelector('#lb-close')?.addEventListener('click', closeLightbox);
  lb.querySelector('#lb-prev')?.addEventListener('click', (e) => { e.stopPropagation(); showImage(currentIdx - 1); });
  lb.querySelector('#lb-next')?.addEventListener('click', (e) => { e.stopPropagation(); showImage(currentIdx + 1); });

  lb.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.id === 'lb-stage' || target.id === 'lb-img-wrap' || target.id === 'kr-lightbox' || target.closest('#lb-close')) {
      closeLightbox();
    }
  });

  window.addEventListener('keydown', (e) => {
    if (!lb!.classList.contains('lb-open')) return;
    if (e.key === 'ArrowLeft')  showImage(currentIdx - 1);
    if (e.key === 'ArrowRight') showImage(currentIdx + 1);
    if (e.key === 'Escape') closeLightbox();
  });

  let wheelCooldown = false;
  window.addEventListener('wheel', (e) => {
    if (!lb!.classList.contains('lb-open')) return;
    if (wheelCooldown) return;

    if (Math.abs(e.deltaY) > 12 || Math.abs(e.deltaX) > 12) {
      wheelCooldown = true;
      const dir = (e.deltaY > 0 || e.deltaX > 0) ? 1 : -1;
      showImage(currentIdx + dir);
      setTimeout(() => { wheelCooldown = false; }, 200);
    }
  }, { passive: true });
</script>
