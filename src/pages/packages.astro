---
import Layout from '../layouts/Layout.astro';

const packages = [
  {
    id: 'portraits',
    badge: 'FAMILY & LIFESTYLE',
    name: 'Portrait & Lifestyle Sessions',
    price: '$300',
    unit: '/ 1 Hour Session',
    popular: false,
    accentColor: '#8B6914',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`,
    description: 'Golden hour family, maternity, couples, senior, and individual portrait sessions with full image ownership.',
    features: [
      '60–70 Fully Edited High-Res Photos',
      '5–10 Sneak Peeks within 24 Hours',
      'Professional Color Grading & Editing',
      'High-Resolution Digital Download Link',
      'Full Ownership & Print Rights Included',
      'Standard 2-Week Album Turnaround',
      'Available 24-Hour Express Turnaround',
    ],
    ctaText: 'Book Portrait Session',
  },
  {
    id: 'weddings-photo',
    badge: 'STUDIO FAVORITE · 2 PHOTOGRAPHERS',
    name: 'Wedding Photography',
    price: '$300',
    unit: '/ Per Hour',
    popular: true,
    accentColor: '#A3802C',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>`,
    description: 'Complete wedding coverage by two lead photographers — Kimberly & Rick capturing simultaneous perspectives.',
    features: [
      'Two Lead Photographers Included (Kimberly & Rick)',
      '75–100 Fully Edited Photos Per Hour',
      '5–10 Sneak Peeks within 24 Hours',
      'Professional Color Grading & Editing',
      'High-Resolution Digital Download Link',
      'Full Ownership & Print Rights Included',
      'Standard 4-Week Album Turnaround',
      'Available 1-Week Express Turnaround Option',
    ],
    ctaText: 'Reserve Your Date',
  },
  {
    id: 'weddings-video',
    badge: 'CINEMATIC FILM',
    name: 'Wedding Videography',
    price: '$300',
    unit: '/ Per Hour',
    popular: false,
    accentColor: '#6B5B3E',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>`,
    description: '4K cinematic wedding story video capturing vow audio, music scoring, and authentic ceremony emotion.',
    features: [
      '4K Cinematic Story Video',
      'Average 15–20 Min Film (6-Hour Wedding)',
      'Professional Audio & Color Grading',
      'High-Resolution Digital Download Link',
      'Standard 4-Week Turnaround Time',
    ],
    ctaText: 'Book Wedding Film',
  },
  {
    id: 'real-estate',
    badge: 'B2B ARCHITECTURAL',
    name: 'Real Estate Media',
    price: '$200',
    unit: 'Starting Price *',
    popular: false,
    accentColor: '#4A6741',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`,
    description: 'HDR flambient interior & exterior photography for top-producing agents. High-impact MLS-ready media.',
    features: [
      'Full Interior, Exterior & Amenities Coverage',
      'HDR Flambient Photo Editing Process',
      'MLS-Ready & High-Res Archival Digital Download',
      'Standard 72-Hour Turnaround Time',
    ],
    addonsTitle: 'Optional Media Add-ons:',
    addons: [
      'Licensed Aerial Drone Media',
      'Cinematic Walkthrough Video Reel',
      '24-Hour Express Turnaround Option',
    ],
    note: '* Pricing subject to change based on property square footage.',
    ctaText: 'Book Property Shoot',
  },
];

const steps = [
  {
    num: '01',
    label: 'Inquire & Book',
    detail: 'Reach out via our contact form. We confirm availability, discuss your vision, and secure your date with a retainer.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
  },
  {
    num: '02',
    label: 'Session Day',
    detail: 'Kimberly & Rick arrive fully prepared. We guide you through every moment so you feel relaxed and natural in front of the lens.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>`,
  },
  {
    num: '03',
    label: 'Sneak Peeks',
    detail: 'Within 24–48 hours you receive a curated selection of your favorite moments — color-graded and ready to share.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>`,
  },
  {
    num: '04',
    label: 'Full Gallery',
    detail: 'Your complete high-resolution gallery arrives in your private download portal — fully edited, print-ready, and yours forever.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>`,
  },
];
---

<Layout
  title="Packages & Pricing | K&R Photography"
  description="Transparent pricing for fine art wedding photography, portraits, videography, and real estate media by Kimberly & Rick. Servicing Central Florida."
>

  <!-- ─── HERO ─── -->
  <section class="hero">
    <div class="hero-bg" style="background-image:url('/DSC_0475-2_result.webp');"></div>
    <div class="hero-vignette"></div>
    <div class="hero-content">
      <div class="hero-eyebrow">Studio Services · Kimberly &amp; Rick · Central Florida</div>
      <h1 class="hero-title">
        <span class="line"><span>Services &amp;</span></span>
        <span class="line"><span>Studio <em>Collections</em></span></span>
      </h1>
      <div class="hero-meta">
        <div class="hero-stat"><strong>Full</strong>Image Rights</div>
        <div class="hero-divider"></div>
        <div class="hero-stat"><strong>24hr</strong>Sneak Peeks</div>
        <div class="hero-divider"></div>
        <div class="hero-stat"><strong>380+</strong>5-Star Reviews</div>
        <div style="margin-left:auto;"><a href="/contact" class="cta-btn">Check Availability</a></div>
      </div>
    </div>
  </section>

  <!-- ─── PROCESS TIMELINE ─── -->
  <section class="timeline-section">
    <div class="timeline-inner">
      <div class="reveal" style="text-align:center;margin-bottom:72px;">
        <span class="timeline-eyebrow"><span class="gold-line"></span>The K&amp;R Experience</span>
        <h2 class="timeline-heading">From Booking to <em>Gallery</em></h2>
        <p class="timeline-subhead">A seamless, stress-free journey from your first message to your final collection.</p>
      </div>

      <div class="timeline-track">
        {steps.map((step, i) => (
          <div class="timeline-step reveal">
            <div class="timeline-step-icon" set:html={step.icon} />
            <div class="timeline-step-num">{step.num}</div>
            <div class="timeline-step-label">{step.label}</div>
            <p class="timeline-step-detail">{step.detail}</p>
            {i < steps.length - 1 && <div class="timeline-connector" />}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── PACKAGES GRID ─── -->
  <section style="background:var(--black);padding:120px 48px;">
    <div style="max-width:1280px;margin:0 auto;">

      <div class="reveal" style="text-align:center;margin-bottom:80px;">
        <span style="font-family:'Cinzel',serif;font-size:13.5px;font-weight:700;letter-spacing:0.28em;text-transform:uppercase;color:#A3802C;display:inline-block;margin-bottom:8px;">
          <span class="gold-line"></span>Pricing &amp; Coverage
        </span>
        <h2 style="font-family:'Cormorant Garamond',serif;font-size:clamp(44px,5vw,72px);font-weight:300;color:#11100F;margin-top:10px;line-height:0.95;">
          The Collections
        </h2>
        <p style="font-size:16px;color:#4D4741;margin-top:16px;font-weight:400;max-width:600px;margin-left:auto;margin-right:auto;line-height:1.65;">
          All collections include full high-resolution digital download rights with private printing privileges and unwatermarked gallery delivery.
        </p>
      </div>

      <!-- Upgraded Pricing Cards Grid -->
      <div class="luxury-pkg-grid reveal">
        {packages.map((pkg, index) => (
          <div class="luxury-pkg-card" style={`--accent: ${pkg.accentColor};`}>

            <!-- Colored Accent Top Bar -->
            <div class="pkg-card-accent-bar"></div>

            <div class="pkg-card-body">
              <!-- Icon + Header Row -->
              <div class="pkg-card-top">
                <div class="pkg-card-icon" set:html={pkg.icon} />
                <div>
                  <div class="luxury-card-tag">{pkg.badge}</div>
                  <div class="luxury-card-num-inline">{['I', 'II', 'III', 'IV'][index]}</div>
                </div>
              </div>

              <h3 class="luxury-card-title">{pkg.name}</h3>

              <!-- Price Box -->
              <div class="luxury-price-box">
                <div class="luxury-price-amount">{pkg.price}</div>
                <div class="luxury-price-unit">{pkg.unit}</div>
              </div>

              <p class="luxury-card-desc">{pkg.description}</p>

              <!-- Features List -->
              <div class="luxury-features-list">
                {pkg.features.map(f => (
                  <div class="luxury-feature-row">
                    <div class="luxury-check-icon">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                        <path d="M20 6L9 17l-5-5"/>
                      </svg>
                    </div>
                    <span class="luxury-feature-text">{f}</span>
                  </div>
                ))}
              </div>

              <!-- Addons Section -->
              {pkg.addons && (
                <div class="luxury-addons-box">
                  <span class="luxury-addons-title">{pkg.addonsTitle}</span>
                  <div class="luxury-addons-list">
                    {pkg.addons.map(a => (
                      <div class="luxury-addon-pill">
                        <span class="luxury-addon-plus">+</span>
                        <span>{a}</span>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {pkg.note && (
                <p class="luxury-card-note">{pkg.note}</p>
              )}
            </div>

            <!-- Frosted Footer CTA Strip -->
            <div class="pkg-card-footer">
              <a
                href={`/contact?service=${encodeURIComponent(pkg.id === 'portraits' ? 'Family & Portraits' : pkg.id === 'real-estate' ? 'Real Estate Photography' : pkg.id === 'weddings-video' ? 'Wedding Videography' : 'Weddings & Couples')}`}
                class="pkg-footer-btn"
              >
                <span>{pkg.ctaText}</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
            </div>

          </div>
        ))}
      </div>

      <!-- Studio Policy & Retainer Banner -->
      <div class="luxury-policy-banner reveal">
        <div class="policy-left">
          <div class="policy-shield-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#A3802C" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
          <div>
            <div class="policy-title">Studio Reservation Policy &amp; Retainer Notice</div>
            <p class="policy-desc">
              * Deposits &amp; retainers are non-refundable to reserve your exclusive date on our calendar. Real Estate media pricing is scaled to property square footage.
            </p>
          </div>
        </div>
        <a href="/contact" class="cta-btn" style="flex-shrink:0;">
          Have Questions? Contact Us
        </a>
      </div>

    </div>
  </section>

  <!-- ─── FAQ ─── -->
  <section style="background:var(--surface);padding:110px 48px;border-top:1px solid rgba(184,150,53,0.18);">
    <div style="max-width:960px;margin:0 auto;">
      <div style="margin-bottom:64px;text-align:center;" class="reveal">
        <span style="font-family:'Cinzel',serif;font-size:13px;font-weight:700;letter-spacing:0.28em;text-transform:uppercase;color:#A3802C;display:inline-block;margin-bottom:8px;">
          <span class="gold-line"></span>Common Inquiries
        </span>
        <h2 style="font-family:'Cormorant Garamond',serif;font-size:clamp(40px,4.5vw,56px);font-weight:300;color:#11100F;margin-top:8px;">Frequently Asked Questions</h2>
      </div>

      <div style="display:flex;flex-direction:column;gap:20px;">
        {[
          { q: 'Why do you always shoot with two lead photographers on weddings?', a: 'Kimberly & Rick bring two distinct artistic eyes simultaneously. Rick captures wide, environmental portraits and architectural detail while Kimberly captures intimate candid emotion and expressions. Nothing is missed.' },
          { q: 'What is your turnaround time for client galleries?', a: 'You receive a curated sneak peek gallery within 24 to 48 hours. Full high-resolution color-graded galleries with print delivery rights are delivered within 2 weeks for portraits/real estate, and 4 weeks for full wedding collections.' },
          { q: 'Do you travel outside of Central Florida?', a: 'Yes! While we are based in Orlando and frequently serve Cocoa Beach, Daytona Beach, and Tampa, we travel worldwide for weddings and portrait commissions.' },
          { q: 'Are print rights and high-resolution files included?', a: 'Yes, full digital download rights are included with every package. You own full rights to download, print, and share your images without watermark restrictions.' },
        ].map(item => (
          <div class="faq-card reveal">
            <h3 class="faq-question">{item.q}</h3>
            <p class="faq-answer">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ─── PROCESS TIMELINE ─── */
  .timeline-section {
    background: #FAF8F5;
    padding: 110px 48px;
    border-top: 1px solid rgba(184, 150, 53, 0.15);
    border-bottom: 1px solid rgba(184, 150, 53, 0.15);
  }

  .timeline-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .timeline-eyebrow {
    font-family: 'Cinzel', serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #A3802C;
    display: inline-block;
    margin-bottom: 10px;
  }

  .timeline-heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(38px, 4.5vw, 60px);
    font-weight: 300;
    color: #11100F;
    line-height: 1;
    margin: 0 0 14px;
  }

  .timeline-heading em {
    font-style: italic;
    color: #A3802C;
  }

  .timeline-subhead {
    font-size: 16px;
    color: #5A524A;
    font-weight: 400;
    max-width: 520px;
    margin: 0 auto;
    line-height: 1.65;
  }

  .timeline-track {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    position: relative;
  }

  .timeline-step {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 24px;
  }

  .timeline-step-icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #FFFFFF;
    border: 1.5px solid rgba(184, 150, 53, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #A3802C;
    margin-bottom: 16px;
    box-shadow: 0 8px 24px rgba(184, 150, 53, 0.12);
    position: relative;
    z-index: 2;
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }

  .timeline-step:hover .timeline-step-icon {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgba(184, 150, 53, 0.22);
    border-color: #A3802C;
  }

  .timeline-step-num {
    font-family: 'Cinzel', serif;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.2em;
    color: #A3802C;
    margin-bottom: 6px;
    opacity: 0.8;
  }

  .timeline-step-label {
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px;
    font-weight: 600;
    color: #11100F;
    margin-bottom: 10px;
    line-height: 1.2;
  }

  .timeline-step-detail {
    font-size: 14px;
    line-height: 1.65;
    color: #5A524A;
    font-weight: 400;
    margin: 0;
  }

  /* Horizontal connector line between steps */
  .timeline-connector {
    position: absolute;
    top: 28px; /* center of the icon */
    right: -50%;
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, rgba(184,150,53,0.5), rgba(184,150,53,0.15));
    z-index: 1;
  }

  /* ─── UPGRADED PRICING CARDS ─── */
  .luxury-pkg-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 36px;
  }

  .luxury-pkg-card {
    position: relative;
    background: #FFFFFF;
    border: 1px solid rgba(184, 150, 53, 0.2);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 16px 45px rgba(26, 24, 22, 0.05);
    display: flex;
    flex-direction: column;
    transition: transform 0.45s var(--ease-out-expo), box-shadow 0.45s var(--ease-out-expo), border-color 0.35s ease;
  }

  .luxury-pkg-card:hover {
    transform: translateY(-8px);
    border-color: var(--accent, rgba(184, 150, 53, 0.7));
    box-shadow: 0 28px 64px rgba(184, 150, 53, 0.15), 0 8px 24px rgba(17, 16, 15, 0.06);
  }

  /* Colored accent bar at top of each card */
  .pkg-card-accent-bar {
    height: 4px;
    background: linear-gradient(90deg, var(--accent, #A3802C), transparent);
    flex-shrink: 0;
  }

  .pkg-card-body {
    padding: 36px 40px 28px;
    flex: 1;
  }

  /* Icon + Tag row */
  .pkg-card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 18px;
  }

  .pkg-card-icon {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: color-mix(in srgb, var(--accent, #A3802C) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent, #A3802C) 30%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent, #A3802C);
    flex-shrink: 0;
  }

  .luxury-card-num-inline {
    font-family: 'Cinzel', serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: rgba(163, 128, 44, 0.5);
    text-align: right;
    margin-top: 4px;
  }

  /* Frosted footer CTA strip */
  .pkg-card-footer {
    padding: 0 40px 36px;
  }

  .pkg-footer-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 15px 24px;
    border-radius: 10px;
    background: color-mix(in srgb, var(--accent, #A3802C) 8%, #FAF8F5);
    border: 1px solid color-mix(in srgb, var(--accent, #A3802C) 35%, transparent);
    color: var(--accent, #A3802C);
    font-family: 'Cinzel', serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
    box-sizing: border-box;
  }

  .pkg-footer-btn:hover {
    background: var(--accent, #A3802C);
    color: #FAF8F5;
    box-shadow: 0 8px 24px color-mix(in srgb, var(--accent, #A3802C) 35%, transparent);
    transform: translateY(-2px);
  }

  .luxury-card-tag {
    font-family: 'Cinzel', serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #A3802C;
  }

  .luxury-card-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 38px;
    font-weight: 400;
    color: #11100F;
    line-height: 1.1;
    margin: 0 0 18px;
  }

  /* Price Box */
  .luxury-price-box {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 22px;
    padding-bottom: 22px;
    border-bottom: 1px solid rgba(184, 150, 53, 0.2);
  }

  .luxury-price-amount {
    font-family: 'Cormorant Garamond', serif;
    font-size: 60px;
    font-weight: 500;
    color: #11100F;
    line-height: 1;
  }

  .luxury-price-unit {
    font-family: 'Cinzel', serif;
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #5A524A;
  }

  .luxury-card-desc {
    font-size: 15px;
    line-height: 1.7;
    color: #4A443E;
    margin-bottom: 28px;
    font-weight: 400;
  }

  /* Features List */
  .luxury-features-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 34px;
  }

  .luxury-feature-row {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .luxury-check-icon {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: rgba(184, 150, 53, 0.12);
    border: 1px solid rgba(184, 150, 53, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #A3802C;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .luxury-feature-text {
    font-size: 15px;
    color: #1A1816;
    font-weight: 500;
    line-height: 1.45;
  }

  /* Addons */
  .luxury-addons-box {
    margin-top: 24px;
    padding: 20px 22px;
    background: rgba(184, 150, 53, 0.06);
    border: 1px dashed rgba(184, 150, 53, 0.35);
    border-radius: 12px;
  }

  .luxury-addons-title {
    font-family: 'Cinzel', serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: #A3802C;
    display: block;
    margin-bottom: 12px;
    text-transform: uppercase;
  }

  .luxury-addons-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

