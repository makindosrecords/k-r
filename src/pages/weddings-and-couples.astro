---
import Layout from '../layouts/Layout.astro';
import EditorialGallery from '../components/EditorialGallery.astro';

const galleryItems = [
  { number: '01', title: 'Wedding Ceremony',         location: 'CENTRAL FLORIDA', type: 'portrait' as const, image: '/weddings/KIM_5922_result.webp', badge: '380+ 5-STAR REVIEWS' },
  { number: '02', title: 'The Wedding Day',          location: 'CENTRAL FLORIDA', type: 'wide'     as const, image: '/weddings/KIM_2100_result.webp', badge: 'EDITORIAL SELECTION' },
  { number: '03', title: 'Bridal Elegance',          location: 'CENTRAL FLORIDA', type: 'portrait' as const, image: '/weddings/KIM_5353_result.webp' },
  { number: '04', title: 'First Look & Vows',        location: 'CENTRAL FLORIDA', type: 'wide'     as const, image: '/weddings/DSC_0045-2_result.webp' },
  { number: '05', title: 'Bride & Groom Intimate',   location: 'CENTRAL FLORIDA', type: 'portrait' as const, image: '/weddings/1%20(5)_result.webp' },
  { number: '06', title: 'Bride & Groom Procession', location: 'CENTRAL FLORIDA', type: 'wide'     as const, image: '/weddings/KIM_2729-3_result.webp' },
  { number: '07', title: 'Bridal Suite Romance',     location: 'CENTRAL FLORIDA', type: 'portrait' as const, image: '/KIM_9003-2.webp' },
  { number: '08', title: 'Sanctuary Entrance',       location: 'CENTRAL FLORIDA', type: 'wide'     as const, image: '/weddings/RIC_4988-2_result.webp' },
  { number: '09', title: 'Ceremony Kiss & Vows',     location: 'CENTRAL FLORIDA', type: 'portrait' as const, image: '/weddings/DSC_0773-2_result.webp' },
  { number: '10', title: 'Ceremony Processional',    location: 'CENTRAL FLORIDA', type: 'wide'     as const, image: '/weddings/DSC_0752-2_result.webp' },
  { number: '11', title: 'Reception Gala',           location: 'CENTRAL FLORIDA', type: 'tall'     as const, image: '/weddings/KIM_8018_result.webp' },
  { number: '12', title: 'Grand Reception Moments',  location: 'CENTRAL FLORIDA', type: 'wide'     as const, image: '/weddings/DSC_0036%20(1)_result.webp' },
  { number: '13', title: 'Golden Hour Portrait',     location: 'CENTRAL FLORIDA', type: 'portrait' as const, image: '/weddings/k1%20(4)_result.webp' },
  { number: '14', title: 'Sunset Couple Embrace',    location: 'CENTRAL FLORIDA', type: 'portrait' as const, image: '/weddings/KIM_6682-2_result.webp' },
];
---

<Layout
  title="Weddings & Couples Photography | K&R Photography"
  description="Wedding & engagement photography by Kimberly & Rick. Two lead photographers. 20+ years experience. 380+ 5-star reviews. Serving Central Florida."
>

  <!-- ─── HERO ─── -->
  <section class="hero">
    <div class="hero-bg" style="background-image:url('/weddings/DSC_0045-2_result.webp');"></div>
    <div class="hero-vignette"></div>
    <div class="hero-content">
      <div class="hero-eyebrow">Weddings & Couples Photography · Central Florida</div>
      <h1 class="hero-title">
        <span class="line"><span>Where Two Lives</span></span>
        <span class="line"><span>Become <em>One Story</em></span></span>
      </h1>
      <div class="hero-meta">
        <div class="hero-stat"><strong>2</strong>Lead Artists Always</div>
        <div class="hero-divider"></div>
        <div class="hero-stat"><strong>Full</strong>Day Coverage</div>
        <div class="hero-divider"></div>
        <div style="margin-left:auto;"><a href="/contact" class="cta-btn">Check Availability</a></div>
      </div>
    </div>
  </section>

  <!-- ─── EDITORIAL GALLERY ─── -->
  <EditorialGallery
    tagline="WEDDINGS & ENGAGEMENTS"
    items={galleryItems}
    sectionId="weddings"
  />

  <!-- ─── FAQ ─── -->
  <section style="background:var(--black);padding:100px 60px;">
    <div style="max-width:900px;margin:0 auto;">
      <div style="margin-bottom:60px;" class="reveal">
        <span style="font-family:'Cinzel',serif;font-size:15px;font-weight:700;letter-spacing:0.28em;text-transform:uppercase;color:#A3802C;"><span class="gold-line"></span>Investment & Details</span>
        <h2 style="font-family:'Cormorant Garamond',serif;font-size:48px;font-weight:300;color:#11100F;margin-top:12px;">Frequently Asked Questions</h2>
      </div>

      <div style="display:flex;flex-direction:column;gap:24px;">
        {[
          { q: 'Why do you always shoot with two lead photographers?', a: 'Kimberly and Rick bring two distinct artistic eyes simultaneously. Rick captures wide, environmental portraits and architectural detail while Kimberly captures intimate candid emotion and expressions. Nothing is missed.' },
          { q: 'What is your turnaround time for wedding galleries?', a: 'You receive a curated sneak peek gallery within 48 hours of your wedding day. Full high-resolution color-graded galleries with print delivery rights are delivered within 4 to 6 weeks.' },
          { q: 'Do you travel outside of Central Florida?', a: 'Yes! While we are based in Orlando and frequently serve Cocoa Beach and Daytona Beach, we travel worldwide for weddings and portrait sessions.' },
        ].map(item => (
          <div style="padding:32px;background:var(--surface);border:1px solid rgba(184,150,53,0.2);box-shadow:0 10px 30px rgba(26,24,22,0.04);border-radius:12px;">
            <h3 style="font-family:'Cormorant Garamond',serif;font-size:24px;font-weight:400;color:#11100F;margin-bottom:12px;">{item.q}</h3>
            <p style="font-size:16px;line-height:1.8;color:#3D3934;font-weight:400;">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>

<script>
  const obs = new IntersectionObserver(entries => entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } }), { threshold: 0.12 });
  document.querySelectorAll('.reveal, .reveal-right, .stagger-children').forEach(el => obs.observe(el));
</script>
