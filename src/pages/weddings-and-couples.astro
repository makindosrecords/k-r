---
import Layout from '../layouts/Layout.astro';
import EditorialGallery from '../components/EditorialGallery.astro';

const galleryItems = [
  { number: '01', title: 'Estate Lawn Couple Portrait', location: 'CENTRAL FLORIDA', type: 'portrait' as const, image: '/weddings/KIM_5922_result.webp', badge: '380+ 5-STAR REVIEWS' },
  { number: '02', title: 'Coastal Sage Bridal Party',   location: 'CENTRAL FLORIDA', type: 'wide'     as const, image: '/weddings/KIM_2100_result.webp', badge: 'EDITORIAL SELECTION' },
  { number: '03', title: 'Bridal Elegance',             location: 'CENTRAL FLORIDA', type: 'portrait' as const, image: '/weddings/KIM_5353_result.webp' },
  { number: '04', title: 'Bella Collina Dip & Kiss',    location: 'CENTRAL FLORIDA', type: 'wide'     as const, image: '/weddings/DSC_0045-2_result.webp' },
  { number: '05', title: 'Bride & Groom Intimate',      location: 'CENTRAL FLORIDA', type: 'portrait' as const, image: '/weddings/1%20(5)_result.webp' },
  { number: '06', title: 'Golden Hour Beach Embrace',   location: 'CENTRAL FLORIDA', type: 'wide'     as const, image: '/weddings/KIM_2729-3_result.webp' },
  { number: '07', title: 'Bridal Suite Romance',        location: 'CENTRAL FLORIDA', type: 'portrait' as const, image: '/KIM_9003-2.webp' },
  { number: '08', title: 'Groomsmen Beach Tug-of-War',  location: 'CENTRAL FLORIDA', type: 'wide'     as const, image: '/weddings/RIC_4988-2_result.webp' },
  { number: '09', title: 'Heart Veil Monochromatic',    location: 'CENTRAL FLORIDA', type: 'portrait' as const, image: '/weddings/DSC_0773-2_result.webp' },
  { number: '10', title: 'Shades & Bouquet Porch Shot', location: 'CENTRAL FLORIDA', type: 'wide'     as const, image: '/weddings/DSC_0752-2_result.webp' },
  { number: '11', title: 'Fun Wedding Party & Grinch',  location: 'CENTRAL FLORIDA', type: 'tall'     as const, image: '/weddings/KIM_8018_result.webp' },
  { number: '12', title: 'Grand Reception Moments',     location: 'CENTRAL FLORIDA', type: 'wide'     as const, image: '/weddings/DSC_0036%20(1)_result.webp' },
  { number: '13', title: 'Golden Hour Portrait',        location: 'CENTRAL FLORIDA', type: 'portrait' as const, image: '/weddings/k1%20(4)_result.webp' },
  { number: '14', title: 'Sunset Couple Embrace',       location: 'CENTRAL FLORIDA', type: 'portrait' as const, image: '/weddings/KIM_6682-2_result.webp' },
];
---

<Layout
  title="Weddings & Couples Photography | K&R Photography"
  description="Wedding & engagement photography by Kimberly & Rick. Two lead photographers. 20+ years experience. 380+ 5-star reviews. Serving Central Florida."
>

  <!-- ─── HERO ─── -->
  <section class="hero">
    <div class="hero-bg" style="background-image:url('/weddings/DSC_0045-2_result.webp');"></div>
    <div class="hero-vignette"></div>
    <div class="hero-content">
      <div class="hero-eyebrow">Weddings & Couples Photography · Central Florida</div>
      <h1 class="hero-title">
        <span class="line"><span>Where Two Lives</span></span>
        <span class="line"><span>Become <em>One Story</em></span></span>
      </h1>
      <div class="hero-meta">
        <div class="hero-stat"><strong>380+</strong>5-Star Reviews</div>
        <div class="hero-divider"></div>
        <div class="hero-stat"><strong>Full</strong>Day Coverage</div>
        <div class="hero-divider"></div>
        <div style="margin-left:auto;"><a href="/contact?service=Weddings+%26+Couples" class="cta-btn">Check Availability</a></div>
      </div>
    </div>
  </section>

  <!-- ─── EDITORIAL GALLERY ─── -->
  <EditorialGallery
    tagline="WEDDINGS & ENGAGEMENTS"
    items={galleryItems}
    sectionId="weddings"
  />

  <!-- ─── CINEMATIC WEDDING FILMS SHOWCASE ─── -->
  <section style="background:var(--black-soft);padding:110px 60px;border-top:1px solid rgba(184,150,53,0.18);border-bottom:1px solid rgba(184,150,53,0.18);">
    <div style="max-width:1440px;margin:0 auto;">
      <div class="reveal" style="text-align:center;margin-bottom:64px;">
        <span style="font-family:'Cinzel',serif;font-size:15px;font-weight:700;letter-spacing:0.28em;text-transform:uppercase;color:#A3802C;">
          <span class="gold-line"></span>Motion &amp; Love Stories
        </span>
        <h2 style="font-family:'Cormorant Garamond',serif;font-size:clamp(44px,5vw,72px);font-weight:300;color:#11100F;margin-top:12px;line-height:0.95;">
          Cinematic Wedding Films
        </h2>
        <p style="font-size:16.5px;color:#5C5650;max-width:580px;margin:16px auto 0;font-family:'Inter',sans-serif;line-height:1.75;">
          Experience our fine art cinematic wedding highlight reels capturing genuine emotion, laughter, and timeless celebration.
        </p>
      </div>

      <div style="display:grid;grid-template-columns:repeat(2, 1fr);gap:40px;" class="wedding-video-grid">
        {[
          {
            id: '4ZPGvGmrzRk',
            title: 'Wedding Highlight Reel',
            meta: 'Cinematic Story & Vows',
            thumb: 'https://img.youtube.com/vi/4ZPGvGmrzRk/maxresdefault.jpg'
          },
          {
            id: 'C4yOaD7xpcI',
            title: 'Wedding Celebration Film',
            meta: 'Full-Day Love Story',
            thumb: 'https://img.youtube.com/vi/C4yOaD7xpcI/maxresdefault.jpg'
          }
        ].map((video) => (
          <div 
            class="film-preview-card" 
            data-video-id={video.id} 
            data-video-title={video.title}
            role="button"
            tabindex="0"
            aria-label={`Play ${video.title}`}
          >
            <div class="film-thumb-wrap">
              <img 
                src={video.thumb} 
                alt={video.title} 
                loading="lazy" 
                class="film-poster-img"
              />
              <div class="film-overlay"></div>
              <div class="film-play-btn">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" style="transform:translateX(2px);">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </div>
            </div>
            <div class="film-caption">
              <span class="film-meta">{video.meta}</span>
              <h3 class="film-title">{video.title}</h3>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── PURE CINEMATIC VIDEO POPOUT ─── -->
  <div id="wedding-video-modal" class="video-modal" aria-hidden="true">
    <div class="video-modal-backdrop" id="wedding-video-backdrop"></div>
    <button class="video-modal-close" id="wedding-video-close" aria-label="Close video">✕</button>
    <div class="video-modal-dialog">
      <div class="video-modal-player-wrap">
        <iframe
          id="wedding-video-iframe"
          src=""
          title="Video player"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </div>

</Layout>

<style>
  /* ── Film Preview Card ── */
  .film-preview-card {
    position: relative;
    border-radius: 6px;
    overflow: hidden;
    background: #FAF8F5;
    border: 1px solid rgba(184, 150, 53, 0.22);
    box-shadow: 0 12px 36px rgba(26, 24, 22, 0.05);
    cursor: pointer;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease, border-color 0.3s ease;
  }
  .film-preview-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 24px 50px rgba(26, 24, 22, 0.12);
    border-color: rgba(184, 150, 53, 0.5);
  }

  .film-thumb-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #11100F;
  }
  .film-poster-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .film-preview-card:hover .film-poster-img {
    transform: scale(1.05);
  }

  .film-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(17,16,15,0.1) 0%, rgba(17,16,15,0.45) 100%);
    transition: background 0.4s ease;
  }
  .film-preview-card:hover .film-overlay {
    background: linear-gradient(180deg, rgba(17,16,15,0.15) 0%, rgba(17,16,15,0.6) 100%);
  }

  .film-play-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(1);
    width: 68px;
    height: 68px;
    border-radius: 50%;
    background: rgba(250, 248, 245, 0.95);
    border: 1px solid rgba(184, 150, 53, 0.5);
    color: #11100F;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), background 0.3s ease, color 0.3s ease;
    z-index: 2;
  }
  .film-preview-card:hover .film-play-btn {
    transform: translate(-50%, -50%) scale(1.1);
    background: #A3802C;
    color: #FAF8F5;
    border-color: #A3802C;
  }

  .film-badge {
    position: absolute;
    top: 14px;
    right: 14px;
    font-family: 'Cinzel', serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #FAF8F5;
    background: rgba(17, 16, 15, 0.7);
    backdrop-filter: blur(8px);
    padding: 5px 12px;
    border-radius: 100px;
    border: 1px solid rgba(184, 150, 53, 0.35);
    z-index: 2;
  }

  .film-caption {
    padding: 22px 28px 24px;
    background: #FAF8F5;
  }
  .film-meta {
    display: block;
    font-family: 'Cinzel', serif;
    font-size: 10.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #A3802C;
    font-weight: 700;
  }
  .film-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 26px;
    font-weight: 400;
    color: #11100F;
    margin-top: 4px;
    line-height: 1.2;
    transition: color 0.3s ease;
  }
  .film-preview-card:hover .film-title {
    color: #A3802C;
  }

  /* ── Video Modal ── */
  .video-modal {
    position: fixed;
    inset: 0;
    z-index: 100000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }
  .video-modal.open {
    opacity: 1;
    visibility: visible;
    pointer-events: all;
  }
  .video-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(5, 4, 3, 0.96);
    backdrop-filter: blur(12px);
  }
  .video-modal-close {
    position: absolute;
    top: 24px;
    right: 28px;
    z-index: 10;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(184, 150, 53, 0.4);
    color: #FAF8F5;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    transition: background 0.25s, transform 0.25s, border-color 0.25s;
  }
  .video-modal-close:hover {
    background: #A3802C;
    border-color: #A3802C;
    transform: rotate(90deg) scale(1.08);
  }
  .video-modal-dialog {
    position: relative;
    z-index: 2;
    width: 96vw;
    max-width: 1600px;
    background: transparent;
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 40px 120px rgba(0, 0, 0, 0.95);
    transform: scale(0.97);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .video-modal.open .video-modal-dialog {
    transform: scale(1);
  }
  .video-modal-player-wrap {
    position: relative;
    width: 100%;
    padding-top: 56.25%;
    background: #000;
  }
  .video-modal-player-wrap iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 900px) {
    .wedding-video-grid { grid-template-columns: 1fr !important; gap: 24px !important; }
  }
</style>

<script>
  // Wedding Modal Controller
  const modal = document.getElementById('wedding-video-modal');
  const iframe = document.getElementById('wedding-video-iframe') as HTMLIFrameElement;
  const titleEl = document.getElementById('wedding-video-title');
  const closeBtn = document.getElementById('wedding-video-close');
  const backdrop = document.getElementById('wedding-video-backdrop');

  function openVideo(id: string, title: string) {
    if (!modal || !iframe) return;
    if (titleEl) titleEl.textContent = title;
    iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1`;
    modal.classList.add('open');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeVideo() {
    if (!modal || !iframe) return;
    modal.classList.remove('open');
    modal.setAttribute('aria-hidden', 'true');
    iframe.src = '';
    document.body.style.overflow = '';
  }

  document.querySelectorAll('.film-preview-card').forEach((card) => {
    card.addEventListener('click', () => {
      const id = card.getAttribute('data-video-id') || '';
      const title = card.getAttribute('data-video-title') || '';
      if (id) openVideo(id, title);
    });
  });

  closeBtn?.addEventListener('click', closeVideo);
  backdrop?.addEventListener('click', closeVideo);

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal?.classList.contains('open')) {
      closeVideo();
    }
  });

  const obs = new IntersectionObserver(entries => entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } }), { threshold: 0.12 });
  document.querySelectorAll('.reveal, .reveal-right, .stagger-children').forEach(el => obs.observe(el));
</script>
