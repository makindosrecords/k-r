</style>

<script>
  function autoSelectService() {
    const params = new URLSearchParams(window.location.search);
    const requestedService = (params.get('package') || params.get('pkg') || params.get('service') || '').trim().toLowerCase();
    const serviceSelect = document.getElementById('serviceType') as HTMLSelectElement | null;
    if (requestedService && serviceSelect) {
      for (let i = 0; i < serviceSelect.options.length; i++) {
        const optVal = serviceSelect.options[i].value.toLowerCase();
        const optText = serviceSelect.options[i].text.toLowerCase();
        if (
          optVal === requestedService || optText === requestedService ||
          (requestedService.includes('video') && (optVal.includes('video') || optText.includes('video'))) ||
          (requestedService.includes('wedding') && !requestedService.includes('video') && optVal.includes('wedding')) ||
          (requestedService.includes('portrait') && (optVal.includes('portrait') || optVal.includes('family'))) ||
          (requestedService.includes('estate') && optVal.includes('estate')) ||
          (requestedService.includes('commercial') && optVal.includes('commercial'))
        ) { 
          serviceSelect.selectedIndex = i; 
          break; 
        }
      }
    }
  }
  autoSelectService();
  window.addEventListener('DOMContentLoaded', autoSelectService);

  // Set minimum date to today and initialize Flatpickr calendar
  const dateInput = document.getElementById('preferredDate') as HTMLInputElement | null;
  const availBadge = document.getElementById('avail-badge') as HTMLSpanElement | null;
  const slotButtons = document.querySelectorAll('.time-slot-btn') as NodeListOf<HTMLLabelElement>;
  let busySlots: Array<{ start: string; end: string; isAllDay: boolean }> = [];
  let fpInstance: any = null;

  function initDatePicker() {
    if (typeof (window as any).flatpickr !== 'undefined' && dateInput) {
      fpInstance = (window as any).flatpickr(dateInput, {
        minDate: 'today',
        defaultDate: 'today',
        dateFormat: 'Y-m-d',
        altInput: true,
        altFormat: 'F j, Y',
        animate: true,
        disableMobile: true, // Use custom luxury theme everywhere
        onChange: function(selectedDates: Date[], dateStr: string) {
          updateSlotAvailability(dateStr);
        }
      });
    } else {
      setTimeout(initDatePicker, 100);
    }
  }
  initDatePicker();

  async function initCalendarAvailability() {
    try {
      const res = await fetch('/api/calendar-availability');
      const data = await res.json();
      if (data && Array.isArray(data.busySlots)) {
        busySlots = data.busySlots;
        if ((data.source === 'live' || data.source === 'cache') && availBadge) {
          availBadge.style.display = 'inline-block';
        }
        if (dateInput && dateInput.value) {
          updateSlotAvailability(dateInput.value);
        }
      }
    } catch (e) {
      console.warn('Could not fetch live calendar availability:', e);
    }
  }
  initCalendarAvailability();

  function updateSlotAvailability(selectedDateStr: string) {
    if (!selectedDateStr) return;
    
    // Check overlapping busy slots for the selected day
    const dayEvents = busySlots.filter(slot => {
      const slotStart = new Date(slot.start).toISOString().split('T')[0];
      return slotStart === selectedDateStr;
    });

    slotButtons.forEach(btn => {
      const radio = btn.querySelector('input[type="radio"]') as HTMLInputElement;
      if (!radio) return;
      const val = radio.value;

      let isOverlapping = false;

      dayEvents.forEach(evt => {
        if (evt.isAllDay) {
          isOverlapping = true;
          return;
        }

        const startHour = new Date(evt.start).getHours();

        if (val.includes('Morning') && startHour < 12) {
          isOverlapping = true;
        } else if (val.includes('Afternoon') && startHour >= 12 && startHour < 16) {
          isOverlapping = true;
        } else if (val.includes('Golden Hour') && startHour >= 16) {
          isOverlapping = true;
        } else if (val.includes('Full Day')) {
          isOverlapping = true;
        }
      });

      if (isOverlapping) {
        btn.classList.add('disabled');
        radio.disabled = true;
        if (radio.checked) {
          radio.checked = false;
        }
      } else {
        btn.classList.remove('disabled');
        radio.disabled = false;
      }
    });

    // Auto-select first available radio if current is disabled
    const checkedRadio = document.querySelector('input[name="timeWindow"]:checked') as HTMLInputElement | null;
    if (!checkedRadio) {
      const firstAvailable = document.querySelector('.time-slot-btn:not(.disabled) input[type="radio"]') as HTMLInputElement | null;
      if (firstAvailable) firstAvailable.checked = true;
    }
  }

  if (dateInput) {
    dateInput.addEventListener('change', () => {
      updateSlotAvailability(dateInput.value);
    });
  }

  let formStarted = false;
  const trackFormStarted = (triggerField: string) => {
    if (!formStarted && typeof (window as any).posthog !== 'undefined') {
      formStarted = true;
      (window as any).posthog.capture('inquiry_form_started', {
        entry_field: triggerField,
        initial_service: (document.getElementById('serviceType') as HTMLSelectElement)?.value || 'General'
      });
    }
  };

  document.querySelectorAll('#booking-form input, #booking-form select, #booking-form textarea').forEach(input => {
    input.addEventListener('focus', () => {
      trackFormStarted((input as HTMLElement).getAttribute('name') || (input as HTMLElement).id || 'unknown');
    }, { once: true });
  });

  const renderedAtInput = document.getElementById('form_rendered_at') as HTMLInputElement | null;
  if (renderedAtInput) {
    renderedAtInput.value = Date.now().toString();
  }

  const bookingForm = document.getElementById('booking-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const btnText = document.getElementById('btn-text') as HTMLSpanElement | null;
  const statusDiv = document.getElementById('form-status') as HTMLDivElement | null;

  if (bookingForm && submitBtn && statusDiv) {
    bookingForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      statusDiv.style.display = 'none';
      submitBtn.disabled = true;
      if (btnText) btnText.innerText = 'Sending\u2026';
      const formData = new FormData(bookingForm);
      const payload = Object.fromEntries(formData.entries());
      try {
        const res = await fetch('/api/booking', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = await res.json();
        if (!res.ok) throw new Error(result.error || 'Failed to send inquiry.');
        const name = (payload.name as string || '').split(' ')[0];
        statusDiv.innerHTML = `
          <div style="font-weight:700;font-size:14px;margin-bottom:4px;">✨ Thank you${name ? ', ' + name : ''}!</div>
          <div>Your inquiry has been sent directly to Kimberly &amp; Rick. We'll reach out within 24 hours.</div>
          <div style="margin-top:8px;font-size:12px;opacity:0.85;">Redirecting you to the home gallery in <span id="redirect-countdown">3</span>s...</div>
        `;
        statusDiv.style.display = 'block';
        statusDiv.style.background = 'rgba(16,50,28,0.08)';
        statusDiv.style.color = '#2D6A4F';
        statusDiv.style.borderColor = 'rgba(45,106,79,0.3)';

        // Track conversion in PostHog
        if (typeof (window as any).posthog !== 'undefined') {
          (window as any).posthog.capture('inquiry_submitted', {
            service_type: payload.serviceType || payload.package || 'general',
            requested_date: payload.preferredDate || payload.date || '',
            preferred_time: payload.timeWindow || '',
            location: payload.targetArea || payload.location || ''
          });
        }

        bookingForm.reset();

        // 3-second countdown and redirect to homepage
        let secondsLeft = 3;
        const countdownEl = document.getElementById('redirect-countdown');
        const interval = setInterval(() => {
          secondsLeft--;
          if (countdownEl) countdownEl.innerText = secondsLeft.toString();
          if (secondsLeft <= 0) {
            clearInterval(interval);
            window.location.href = '/';
          }
        }, 1000);
      } catch (err: any) {
        statusDiv.innerText = '⚠️ ' + (err.message || 'An error occurred. Please try again.');
        statusDiv.style.display = 'block';
        statusDiv.style.background = 'rgba(50,20,10,0.08)';
        statusDiv.style.color = '#9B1C1C';
        statusDiv.style.borderColor = 'rgba(155,28,28,0.3)';
        submitBtn.disabled = false;
        if (btnText) btnText.innerText = 'Send Inquiry to K&R';
      }
    });
  }
</script>
