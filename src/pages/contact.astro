---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Inquire & Book | K&R Photography | Orlando, Daytona, Cocoa Beach"
  description="Book your wedding, portrait session, or real estate photography with Kimberly & Rick. Central Florida's trusted duo with 380+ 5-star Google reviews."
  hideFooter={true}
>
  <Fragment slot="head">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/flatpickr" defer></script>
  </Fragment>

  <!-- ─── MODAL PAGE CONTAINER ─── -->
  <div class="inquiry-page-wrapper">

    <!-- Dark Blurred Backdrop Image -->
    <div class="modal-backdrop-img"></div>
    <div class="modal-backdrop-overlay"></div>

    <!-- ─── MODAL CARD ─── -->
    <div class="modal-card">

      <!-- Modal Header Bar -->
      <div class="modal-header">
        <div>
          <div class="modal-eyebrow">Studio Inquiries &amp; Booking</div>
          <h1 class="modal-title">Reserve Your Date with <em>Kimberly &amp; Rick</em></h1>
        </div>
        <a href="/" class="modal-close-btn" title="Back to Home">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </a>
      </div>

      <!-- Modal Content Body (2-Column Grid) -->
      <div class="modal-body">

        <!-- Left Info Column -->
        <div class="modal-left-col">
          <div class="intro-quote-card">
            <div class="intro-quote-mark">“</div>
            <p class="modal-intro">
              We photograph only a select number of celebrations each season to give every client our complete, undivided creative focus.
            </p>
            <div class="intro-author">— Kimberly &amp; Rick</div>
          </div>

          <!-- Contact Quick Cards -->
          <div class="quick-cards-grid">
            <a href="tel:+14074979239" class="q-card">
              <div class="q-icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.79a16 16 0 0 0 6 6l1.88-1.88a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </div>
              <div>
                <div class="q-label">Phone</div>
                <div class="q-val">(407) 497-9239</div>
              </div>
            </a>

            <a href="mailto:kimberly@kandrpix.com" class="q-card">
              <div class="q-icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </div>
              <div>
                <div class="q-label">Email</div>
                <div class="q-val">kimberly@kandrpix.com</div>
              </div>
            </a>

            <a href="https://instagram.com/kandrpix" target="_blank" rel="noopener" class="q-card">
              <div class="q-icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              </div>
              <div>
                <div class="q-label">Instagram</div>
                <div class="q-val">@kandrpix</div>
              </div>
            </a>

            <div class="q-card no-link">
              <div class="q-icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div>
                <div class="q-label">Territory</div>
                <div class="q-val">Central FL &amp; Destination</div>
              </div>
            </div>
          </div>

          <!-- Trust Callout -->
          <div class="modal-trust-callout">
            <div class="stars">★★★★★</div>
            <div class="trust-title">380+ Verified Reviews</div>
            <div class="trust-sub">20+ Years Capturing Weddings &amp; Portraits</div>
          </div>
        </div>

        <!-- Right Form Column -->
        <div class="modal-right-col">
          <div id="form-status" style="display:none;margin-bottom:14px;padding:12px 16px;border-radius:8px;font-size:13px;border:1px solid;"></div>

          <form id="booking-form">
            <!-- Invisible Anti-Spam Honeypot & Timestamp Verification -->
            <div style="display:none !important; position:absolute; left:-9999px;" aria-hidden="true">
              <label for="website_url">Leave this field blank</label>
              <input type="text" id="website_url" name="website_url" tabindex="-1" autocomplete="off" />
              <input type="hidden" id="form_rendered_at" name="form_rendered_at" value="" />
            </div>

            <div class="f-row-2">
              <div class="f-wrap">
                <label for="name" class="f-label">Full Name <span class="req">*</span></label>
                <input type="text" id="name" name="name" required placeholder="Sarah Jenkins" class="f-input" />
              </div>
              <div class="f-wrap">
                <label for="email" class="f-label">Email Address <span class="req">*</span></label>
                <input type="email" id="email" name="email" required placeholder="sarah@example.com" class="f-input" />
              </div>
            </div>

            <div class="f-row-2">
              <div class="f-wrap">
                <label for="phone" class="f-label">Phone Number</label>
                <input type="tel" id="phone" name="phone" placeholder="(407) 555-0100" class="f-input" />
              </div>
              <div class="f-wrap">
                <label for="serviceType" class="f-label">Service Type <span class="req">*</span></label>
                <select id="serviceType" name="serviceType" required class="f-input f-select">
                  <option value="" disabled selected>Select Service</option>
                  <option value="Weddings & Couples">Weddings &amp; Couples Photography</option>
                  <option value="Wedding Videography">Wedding Videography</option>
                  <option value="Family & Portraits">Family &amp; Lifestyle Portraits</option>
                  <option value="Real Estate Photography">Real Estate &amp; Architectural</option>
                  <option value="Commercial & Event">Commercial &amp; Corporate Event</option>
                </select>
              </div>
            </div>

            <div class="f-row-2">
              <div class="f-wrap">
                <label for="targetArea" class="f-label">Venue / Location <span class="req">*</span></label>
                <input type="text" id="targetArea" name="targetArea" required placeholder="e.g. Bella Collina, Cocoa Beach" class="f-input" />
              </div>
              <div class="f-wrap">
                <label for="preferredDate" class="f-label">Preferred Date <span class="req">*</span></label>
                <div class="date-picker-wrap">
                  <input type="text" id="preferredDate" name="preferredDate" required placeholder="Select a date..." class="f-input date-input-picker" readonly />
                  <svg class="date-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                </div>
              </div>
            </div>

            <!-- Interactive Time Window Selector -->
            <div class="f-wrap" id="time-window-container" style="margin-top: 4px; margin-bottom: 16px;">
              <label class="f-label" style="display:flex; justify-content:space-between; align-items:center;">
                <span>Preferred Shoot Time Window</span>
                <span id="avail-badge" style="font-size:10px; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:#2D6A4F; display:none;">● Live Availability Active</span>
              </label>
              <div class="time-slot-grid">
                <label class="time-slot-btn">
                  <input type="radio" name="timeWindow" value="Morning (8:00 AM – 11:30 AM)" checked />
                  <span class="slot-content">
                    <span class="slot-title">Morning</span>
                    <span class="slot-time">8:00 – 11:30 AM</span>
                  </span>
                </label>
                <label class="time-slot-btn">
                  <input type="radio" name="timeWindow" value="Early Afternoon (12:00 PM – 3:30 PM)" />
                  <span class="slot-content">
                    <span class="slot-title">Afternoon</span>
                    <span class="slot-time">12:00 – 3:30 PM</span>
                  </span>
                </label>
                <label class="time-slot-btn">
                  <input type="radio" name="timeWindow" value="Golden Hour / Sunset (4:30 PM – 7:30 PM)" />
                  <span class="slot-content">
                    <span class="slot-title">Golden Hour</span>
                    <span class="slot-time">4:30 – 7:30 PM</span>
                  </span>
                </label>
                <label class="time-slot-btn">
                  <input type="radio" name="timeWindow" value="Full Day Coverage (Weddings / Events)" />
                  <span class="slot-content">
                    <span class="slot-title">Full Day</span>
                    <span class="slot-time">Weddings &amp; Events</span>
                  </span>
                </label>
              </div>
            </div>

            <div class="f-wrap">
              <label for="details" class="f-label">Tell Us About Your Vision <span class="req">*</span></label>
              <textarea id="details" name="details" rows="3" required placeholder="Share your venue, story, or photography goals..." class="f-input f-textarea"></textarea>
            </div>

            <div class="f-footer">
              <div class="f-privacy">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                Details are private &amp; secure.
              </div>
              <button type="submit" id="submit-btn" class="f-submit-btn">
                <span id="btn-text">Send Inquiry to K&amp;R</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </button>
            </div>
          </form>
        </div>

      </div>
    </div>
  </div>

</Layout>

<style>
  /* Lock page height & create backdrop */
  .inquiry-page-wrapper {
    min-height: 100vh;
    height: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 100px 20px 40px;
    position: relative;
    box-sizing: border-box;
  }

  /* Make fixed header dark-themed on inquiry page */
  :global(.site-header) {
    background: rgba(17, 16, 15, 0.85) !important;
    backdrop-filter: blur(20px) !important;
    border-bottom: 1px solid rgba(184, 150, 53, 0.2) !important;
  }
  :global(.site-header .logo-title) {
    color: #FAF8F5 !important;
  }
  :global(.site-header .nav-link) {
    color: #FAF8F5 !important;
  }
  :global(.site-header .nav-phone-link) {
    color: #FAF8F5 !important;
  }
  :global(#mobile-floating-bar) {
    display: none !important;
  }

  .modal-backdrop-img {
    position: fixed;
    inset: 0;
    background-image: url('/weddings/KIM_7326-2_result.webp');
    background-size: cover;
    background-position: center;
    filter: blur(8px) brightness(0.4);
    transform: scale(1.05);
    z-index: 0;
  }

  .modal-backdrop-overlay {
    position: fixed;
    inset: 0;
    background: radial-gradient(circle at center, rgba(17,16,15,0.6) 0%, rgba(17,16,15,0.9) 100%);
    z-index: 1;
  }

  /* Modal Card Frame */
  .modal-card {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1080px;
    background: #FFFFFF;
    border: 1px solid rgba(184, 150, 53, 0.35);
    border-radius: 20px;
    box-shadow: 0 25px 80px rgba(0, 0, 0, 0.5), 0 0 40px rgba(184, 150, 53, 0.15);
    overflow: hidden;
    margin: auto;
  }

  /* Modal Header Bar */
  .modal-header {
    background: linear-gradient(135deg, #11100F 0%, #1C1A17 100%);
    padding: 22px 32px;
    border-bottom: 1px solid rgba(184, 150, 53, 0.25);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .modal-eyebrow {
    font-family: 'Cinzel', serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #A3802C;
    margin-bottom: 4px;
  }

  .modal-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(22px, 2.5vw, 30px);
    font-weight: 300;
    color: #FAF8F5;
    margin: 0;
    line-height: 1.1;
  }

  .modal-title em {
    font-style: italic;
    color: #C9A84C;
  }

  .modal-close-btn {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(184, 150, 53, 0.3);
    color: #FAF8F5;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease;
    flex-shrink: 0;
  }

  .modal-close-btn:hover {
    background: rgba(163, 128, 44, 0.3);
    border-color: #A3802C;
  }

  /* Modal Body */
  .modal-body {
    display: grid;
    grid-template-columns: 0.9fr 1.3fr;
    align-items: stretch;
  }

  /* Left Column */
  .modal-left-col {
    background: #FAF8F5;
    padding: 32px 30px;
    border-right: 1px solid rgba(184, 150, 53, 0.18);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
  }

  .intro-quote-card {
    position: relative;
    background: #FFFFFF;
    border: 1px solid rgba(184, 150, 53, 0.25);
    border-left: 3px solid #D4AF37;
    border-radius: 10px;
    padding: 16px 18px 14px 20px;
    box-shadow: 0 4px 16px rgba(184, 150, 53, 0.06);
  }

  .intro-quote-mark {
    position: absolute;
    top: -6px;
    right: 12px;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 42px;
    line-height: 1;
    color: rgba(184, 150, 53, 0.2);
    pointer-events: none;
  }

  .modal-intro {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 16.5px;
    font-style: italic;
    line-height: 1.55;
    color: #2E2924;
    margin: 0;
    letter-spacing: 0.01em;
  }

  .intro-author {
    font-family: 'Cinzel', serif;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #A3802C;
    margin-top: 10px;
    text-align: right;
  }

  .quick-cards-grid {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .q-card {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #FFFFFF;
    border: 1px solid rgba(184, 150, 53, 0.2);
    border-radius: 10px;
    padding: 10px 14px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.2s ease;
  }

  .q-card:not(.no-link):hover {
    border-color: rgba(163, 128, 44, 0.6);
    box-shadow: 0 4px 14px rgba(184, 150, 53, 0.12);
    transform: translateX(3px);
  }

  .q-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(163, 128, 44, 0.08);
    border: 1px solid rgba(163, 128, 44, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #A3802C;
    flex-shrink: 0;
  }

  .q-label {
    font-family: 'Cinzel', serif;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #A3802C;
    margin-bottom: 1px;
  }

  .q-val {
    font-size: 13px;
    font-weight: 600;
    color: #11100F;
  }

  .modal-trust-callout {
    background: #FFFFFF;
    border: 1px solid rgba(184, 150, 53, 0.22);
    border-radius: 10px;
    padding: 14px 16px;
    text-align: center;
  }

  .stars {
    color: #A3802C;
    font-size: 13px;
    letter-spacing: 2px;
    margin-bottom: 3px;
  }

  .trust-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 17px;
    font-weight: 500;
    color: #11100F;
  }

  .trust-sub {
    font-size: 11px;
    color: #7A726C;
    margin-top: 2px;
  }

  /* Right Column (Form) */
  .modal-right-col {
    padding: 28px 32px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .f-row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .f-wrap {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .f-label {
    font-family: 'Cinzel', serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #11100F;
  }

  .req { color: var(--gold); }

  .f-input {
    background: #FAF8F5;
    border: 1px solid rgba(184, 150, 53, 0.25);
    border-radius: 8px;
    color: #11100F;
    padding: 10px 14px;
    font-size: 13.5px;
    font-family: 'Plus Jakarta Sans', sans-serif;
    transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
    width: 100%;
    box-sizing: border-box;
    outline: none;
    height: 42px;
  }

  .f-textarea {
    height: auto;
    min-height: 80px;
    resize: vertical;
    padding: 10px 14px;
  }

  .f-input::placeholder { color: #A09892; }

  .f-input:focus {
    border-color: #B89635;
    background: #FFFFFF;
    box-shadow: 0 0 0 3px rgba(184, 150, 53, 0.12);
  }

  .f-select {
    background-color: #FAF8F5;
    cursor: pointer;
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23A3802C' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 14px center;
    background-size: 14px;
    padding-right: 38px;
  }

  .date-picker-wrap {
    position: relative;
    width: 100%;
  }

  .date-picker-wrap .date-icon {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: #A3802C;
    pointer-events: none;
  }

  .date-input-picker {
    cursor: pointer;
    background-color: #FAF8F5;
  }

  /* Flatpickr Luxury Theme Overrides */
  :global(.flatpickr-calendar) {
    background: #FFFFFF !important;
    border: 1px solid rgba(184, 150, 53, 0.35) !important;
    border-radius: 12px !important;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.15) !important;
    font-family: 'Plus Jakarta Sans', sans-serif !important;
  }

  :global(.flatpickr-months) {
    background: #11100F !important;
    border-top-left-radius: 11px !important;
    border-top-right-radius: 11px !important;
    color: #FAF8F5 !important;
    padding: 6px 0 !important;
  }

  :global(.flatpickr-current-month) {
    font-family: 'Cinzel', serif !important;
    font-size: 110% !important;
    color: #FAF8F5 !important;
    padding: 2px 0 0 0 !important;
  }

  :global(.flatpickr-current-month .flatpickr-monthDropdown-months) {
    background: #1F1C18 !important;
    color: #FAF8F5 !important;
    font-family: 'Cinzel', serif !important;
    font-size: 13px !important;
    font-weight: 700 !important;
    border: 1px solid rgba(184, 150, 53, 0.4) !important;
    border-radius: 6px !important;
    padding: 2px 6px !important;
    cursor: pointer !important;
  }

  :global(.flatpickr-current-month .flatpickr-monthDropdown-months option) {
    background: #11100F !important;
    color: #FAF8F5 !important;
    padding: 6px 10px !important;
  }

  :global(.flatpickr-current-month .flatpickr-monthDropdown-months:hover) {
    background: #2A2620 !important;
    border-color: #B89635 !important;
  }

  :global(.flatpickr-current-month input.cur-year) {
    font-family: 'Cinzel', serif !important;
    font-weight: 700 !important;
    color: #C9A84C !important;
  }

  :global(.flatpickr-months .flatpickr-prev-month),
  :global(.flatpickr-months .flatpickr-next-month) {
    color: #C9A84C !important;
    fill: #C9A84C !important;
    padding: 6px !important;
  }

  :global(.flatpickr-months .flatpickr-prev-month:hover svg),
  :global(.flatpickr-months .flatpickr-next-month:hover svg) {
    fill: #FAF8F5 !important;
  }

  :global(.flatpickr-weekday) {
    font-family: 'Cinzel', serif !important;
    font-weight: 700 !important;
    color: #A3802C !important;
    font-size: 11px !important;
  }

  :global(.flatpickr-day.today) {
    border: 2px solid #D4AF37 !important;
    background: rgba(212, 175, 55, 0.15) !important;
    font-weight: 700 !important;
    color: #8B6914 !important;
  }

  :global(.flatpickr-day.selected) {
    background: #11100F !important;
    border-color: #11100F !important;
    color: #FAF8F5 !important;
    font-weight: 700 !important;
  }

  :global(.flatpickr-day.flatpickr-disabled),
  :global(.flatpickr-day.flatpickr-disabled:hover) {
    color: #B0A8A0 !important;
    background-color: #F4EFEA !important;
    text-decoration: line-through !important;
    opacity: 0.45 !important;
