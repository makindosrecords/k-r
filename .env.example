# Resend API Key for Email Routing (https://resend.com)
# When set, inquiry submissions from /contact and /api/booking will trigger live email routing.
RESEND_API_KEY=re_your_api_key_here

# Local Testing Override
# Set your personal email below to receive all test inquiry alerts instead of Kimberly's inbox
TEST_EMAIL=your_email@example.com

# Studio Contact Defaults (Production)
STUDIO_EMAIL=kimberly@kandrpix.com

# Sender email domain configured in Resend (use onboarding@resend.dev for free testing)
RESEND_FROM_EMAIL=onboarding@resend.dev

# Google Calendar iCal Feed URL (Read-Only)
GOOGLE_CALENDAR_ICAL_URL=https://calendar.google.com/calendar/ical/your_email%40gmail.com/public/basic.ics

# PostHog Analytics
PUBLIC_POSTHOG_KEY=phc_your_posthog_project_api_key_here
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
